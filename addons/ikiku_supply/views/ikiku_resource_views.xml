<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_resource_list" model="ir.ui.view">
    <field name="name">ikiku.resource.list</field>
    <field name="model">ikiku.resource</field>
    <field name="arch" type="xml">
      <list string="نیروها" decoration-success="state == 'active'"
            decoration-warning="state == 'submitted'">
        <field name="name"/>
        <field name="headline"/>
        <field name="province_id"/>
        <field name="city"/>
        <field name="standing"/>
        <field name="supported_claim_count" string="ادعای پشتیبانی‌شده"/>
        <field name="contested_claim_count" string="مورد اعتراض"/>
        <field name="is_verified"/>
        <field name="state"/>
      </list>
    </field>
  </record>

  <record id="view_resource_form" model="ir.ui.view">
    <field name="name">ikiku.resource.form</field>
    <field name="model">ikiku.resource</field>
    <field name="arch" type="xml">
      <form string="نیرو">
        <header>
          <button name="action_submit" type="object" string="ثبت برای بررسی"
                  class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_activate" type="object" string="فعال‌سازی"
                  class="btn-primary" invisible="state != 'submitted'"
                  groups="ikiku_base.group_ikiku_staff"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" placeholder="نام و نام خانوادگی"/></h1>
            <h3><field name="headline" placeholder="یک خط دربارهٔ خودتان"/></h3>
          </div>
          <group>
            <group>
              <field name="partner_id"/>
              <field name="province_id"/>
              <field name="city"/>
            </group>
            <group>
              <field name="standing" readonly="1"/>
              <field name="is_verified" readonly="1"/>
              <field name="slug" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="مهارت‌ها">
              <field name="skill_ids">
                <list editable="bottom">
                  <field name="skill_type_id"/>
                  <field name="skill_id"/>
                  <field name="skill_level_id"/>
                </list>
              </field>
            </page>
            <page string="سابقه">
              <field name="resume_line_ids">
                <list editable="bottom">
                  <field name="line_type"/>
                  <field name="name"/>
                  <field name="employer_name"/>
                  <field name="spec_node_id"/>
                  <field name="date_start"/>
                  <field name="date_start_fa" string="از (شمسی)"/>
                  <field name="date_end"/>
                  <field name="assertion_id" readonly="1"/>
                </list>
              </field>
            </page>
            <page string="در دسترس">
              <field name="availability_ids">
                <list editable="bottom">
                  <field name="date_start"/>
                  <field name="date_start_fa" string="از (شمسی)"/>
                  <field name="date_end"/>
                  <field name="date_end_fa" string="تا (شمسی)"/>
                  <field name="province_id"/>
                  <field name="city"/>
                  <field name="hours_per_week"/>
                  <field name="state"/>
                </list>
              </field>
            </page>
            <page string="ادعاها">
              <field name="assertion_ids" readonly="1">
                <list>
                  <field name="claim_kind"/><field name="spec_node_id"/>
                  <field name="method"/><field name="strength"/><field name="state"/>
                </list>
              </field>
            </page>
            <page string="شرح"><field name="bio"/></page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_resource" model="ir.actions.act_window">
    <field name="name">نیروها</field>
    <field name="res_model">ikiku.resource</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
