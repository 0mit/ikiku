<?xml version="1.0" encoding="utf-8"?>
<odoo><data noupdate="1">
  <!-- The safety net under the callback: a missed or unconfigured callback still
       settles every tracked SMS within Kavenegar's 48-hour status window. -->
  <record id="ir_cron_sms_kavenegar_poll_status" model="ir.cron" forcecreate="True">
    <field name="name">SMS: Kavenegar delivery status</field>
    <field name="model_id" ref="sms.model_sms_tracker"/>
    <field name="state">code</field>
    <field name="code">model._kavenegar_poll_status()</field>
    <field name="user_id" ref="base.user_root"/>
    <field name="interval_number">10</field>
    <field name="interval_type">minutes</field>
  </record>
</data></odoo>
