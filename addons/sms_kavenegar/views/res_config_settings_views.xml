<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.sms.kavenegar</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="sms.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//widget[@service_name='sms']" position="before">
        <div class="content-group">
          <div class="d-flex gap-2">
            <field name="sms_kavenegar_enabled"/>
            <label for="sms_kavenegar_enabled" class="o_light_label"/>
          </div>
          <div class="content-group mt-2" invisible="not sms_kavenegar_enabled">
            <div class="row mt-1">
              <label for="sms_kavenegar_api_key" class="col-lg-4 o_light_label"/>
              <field name="sms_kavenegar_api_key" class="col-lg-8" password="True"/>
            </div>
            <div class="row mt-1">
              <label for="sms_kavenegar_sender" class="col-lg-4 o_light_label"/>
              <field name="sms_kavenegar_sender" class="col-lg-8" placeholder="10004346"/>
            </div>
            <div class="row mt-1">
              <label for="sms_kavenegar_otp_template" class="col-lg-4 o_light_label"/>
              <field name="sms_kavenegar_otp_template" class="col-lg-8"/>
            </div>
            <div class="row mt-1">
              <label for="sms_kavenegar_callback_url" class="col-lg-4 o_light_label"/>
              <field name="sms_kavenegar_callback_url" class="col-lg-8" widget="CopyClipboardChar"/>
            </div>
            <div class="row mt-1">
              <label for="sms_kavenegar_test_number" class="col-lg-4 o_light_label"/>
              <field name="sms_kavenegar_test_number" class="col-lg-8" placeholder="+989121234567"/>
            </div>
            <div class="mt-2">
              <button name="action_sms_kavenegar_check_account" type="object" class="btn-link"
                      icon="oi-arrow-right" string="Check account"/>
              <button name="action_sms_kavenegar_send_test" type="object" class="btn-link"
                      icon="oi-arrow-right" string="Send test SMS"/>
            </div>
          </div>
        </div>
      </xpath>
      <xpath expr="//widget[@service_name='sms']" position="attributes">
        <attribute name="invisible">sms_kavenegar_enabled</attribute>
      </xpath>
    </field>
  </record>
</odoo>
