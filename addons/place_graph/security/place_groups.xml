<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Odoo 18+ hangs a group off a privilege, and the privilege off a category. -->
    <record id="module_category_place" model="ir.module.category">
      <field name="name">Places</field>
      <field name="sequence">25</field>
    </record>
    <record id="privilege_place" model="res.groups.privilege">
      <field name="name">Places</field>
      <field name="sequence">10</field>
      <field name="category_id" ref="module_category_place"/>
    </record>

    <!-- Reading places is everybody's; changing the map is a job, because every record that
         points at a place inherits the change. The administrator is named on THIS record:
         base loads its own user as noupdate data, so writing groups onto that record from
         here would be read once and ignored ever after. -->
    <record id="group_place_editor" model="res.groups">
      <field name="name">Place editor</field>
      <field name="privilege_id" ref="privilege_place"/>
      <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
      <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
  </data>
</odoo>
