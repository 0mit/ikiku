<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- The home page. The inherit only swaps the empty #wrap for home_content, so the
       words live in one template a person can read without the xpath around them. -->
  <template id="homepage" inherit_id="website.homepage" name="ایکیکو — خانه">
    <xpath expr="//div[@id='wrap']" position="replace">
      <div id="wrap"><t t-call="ikiku_portal.home_content"/></div>
    </xpath>
  </template>

  <template id="home_content" name="ایکیکو — محتوای خانه">
    <t t-set="Demand" t-value="request.env['ikiku.demand']"/>
    <t t-set="jobs" t-value="Demand.ikiku_public_open(limit=6)"/>
    <t t-set="jobs_count" t-value="Demand.ikiku_public_open_count()"/>
    <div class="ikiku">

      <section class="ikiku__band ikiku__band--hero">
        <div class="ikiku__wide ikiku__hero">
          <div class="ikiku__hero-copy">
            <p class="ikiku__kicker">ایکیکو · کافه و رستوران</p>
            <h1 class="ikiku__ask">آیکی؟ کو؟</h1>
            <p class="ikiku__plain">کار تو کافه و رستوران می‌خواید؟ یا نیرو لازم دارید؟</p>
          </div>

          <div id="ikiku-doors" class="ikiku__doors">
            <a class="ikiku__door" href="/ki">
              <span class="ikiku__door-ask">کی؟</span>
              <strong class="ikiku__door-who">دنبالِ کار هستم</strong>
              <span>ظرف‌شستن، قهوه، آشپزی، گارسونی. با شماره موبایل، حدودِ ۳ دقیقه.</span>
              <span class="ikiku__door-go">ثبت‌نام برای کار</span>
            </a>
            <a class="ikiku__door" href="/ku">
              <span class="ikiku__door-ask">کو؟</span>
              <strong class="ikiku__door-who">نیرو لازم دارم</strong>
              <span>کافه یا رستوران دارید؟ بگید چه نیرویی، چند نفر و از کِی.</span>
              <span class="ikiku__door-go">نیرو می‌خوام</span>
            </a>
            <p class="ikiku__doors-note">ایمیل و رمز لازم نیست. فقط شماره موبایل.</p>
          </div>

          <p class="ikiku__lede">
            این اسم دو تا سؤاله: <strong>کی؟</strong> و <strong>کو؟</strong> — چه کسی، و کجا.
            کارِ ایکیکو اینه که آیکی، حتی کسی که هنوز نمی‌شناسیدش، بشه کسی که می‌شناسیدش و می‌دونید کجاست.
          </p>
        </div>
      </section>

      <section class="ikiku__band">
        <div class="ikiku__wide">
          <div class="ikiku__band-head">
            <div>
              <p class="ikiku__kicker">همه می‌بینن</p>
              <h2>کارهای باز</h2>
              <p class="ikiku__lead">نیرویی که کافه‌ها و رستوران‌ها لازم دارن. اسمِ کافه یا رستوران اینجا نوشته نمیشه.</p>
            </div>
            <a t-if="jobs_count" class="ikiku__secondary" href="/jobs">
              همه‌ی کارهای باز (<t t-out="Demand.ikiku_fa_digits(jobs_count)"/>)</a>
          </div>
          <t t-call="ikiku_portal.job_cards"/>
          <p t-if="jobs" class="ikiku__lead">کار می‌خواید؟ <a href="/ki">ثبت‌نام کنید</a>؛ ایکیکو خودش شما رو معرفی می‌کنه.</p>
        </div>
      </section>

      <section class="ikiku__band ikiku__band--soft">
        <div class="ikiku__wide">
          <div class="ikiku__band-head">
            <div>
              <p class="ikiku__kicker">از ثبت‌نام تا سرِ کار</p>
              <h2>چطوری کار می‌کنه؟</h2>
            </div>
          </div>
          <ol class="ikiku__steps">
            <li><strong>کارگر</strong> میگه چه کاری بلده و کِی آزاده.</li>
            <li><strong>کافه یا رستوران</strong> میگه چه نیرویی، چند نفر، از کِی.</li>
            <li><strong>ایکیکو</strong> کسانی رو که به هم می‌خورن معرفی می‌کنه، و میگه هر عدد از کجا اومده.</li>
            <li><strong>قرارِ کار</strong> که گذاشته شد، همه می‌بینن. اگه به هم بخوره هم همه می‌بینن.</li>
          </ol>
        </div>
      </section>

      <section class="ikiku__band">
        <div class="ikiku__wide ikiku__trust">
          <div class="ikiku__tenets-panel">
            <p class="ikiku__kicker">مرام‌نامه، ساده</p>
            <h2>قول‌هایی که دادیم</h2>
            <ul class="ikiku__tenets">
              <li><strong>هر کاری آبرو داره.</strong> هیچ کاری «ساده» نیست؛ ظرف‌شستن هم فنه. تو ایکیکو آدم‌ها شماره نیستن. <small>بند ۱</small></li>
              <li><strong>آبروی کاری مالِ خودتونه.</strong> هر چی تو کار به دست میارید به اسمِ خودتون نوشته میشه و با شما میاد؛ به شهرِ دیگه، به کارِ دیگه. <small>بند ۲</small></li>
              <li><strong>هر حرفی صاحب داره.</strong> معلومه کی گفته و از کجا می‌دونه. حرفی که نشه پرسید «کی گفته؟» حساب نیست. <small>بند ۳</small></li>
              <li><strong>امنیتِ آدم‌ها اول.</strong> کارتون رو همه می‌بینن؛ آدرس، شماره، کدِ ملی و برنامه‌ی روزتون رو نه. <small>بند ۷</small></li>
              <li><strong>واسطه‌ایم، نه دلال.</strong> هیچ‌کس با پول رتبه‌ش بالا نمیره، و هیچ‌کس با پول نقدی رو پاک نمی‌کنه. <small>بند ۸</small></li>
            </ul>
            <p class="ikiku__links"><a class="ikiku__link" href="/help/maram">خلاصه‌ی ساده‌ی همه‌ی بندها</a>
              <a class="ikiku__link" href="/manifest">متنِ کاملِ مرام‌نامه</a></p>
          </div>

          <div class="ikiku__ledgers-panel">
            <p class="ikiku__kicker">همه می‌بینن</p>
            <h2>جلوی چشمِ همه</h2>
            <ul class="ikiku__ledgers">
              <li><a href="/jobs"><strong>کارهای باز</strong>
                <span>نیرویی که کافه‌ها و رستوران‌ها لازم دارن.</span></a></li>
              <li><a href="/bookings"><strong>دفترِ قرارهای کار</strong>
                <span>هر قرارِ کاری که گذاشته شد، و هر قراری که به هم خورد.</span></a></li>
              <li><a href="/costs"><strong>هزینه‌ی مشترک</strong>
                <span>خرجِ واقعیِ ایکیکو، و سهمِ هر کافه و رستوران.</span></a></li>
            </ul>
          </div>
        </div>
      </section>

      <div class="ikiku__wide">
        <p class="ikiku__lead">شروعِ کار: کافه‌ها و رستوران‌های ایران. مرام‌نامه هنوز پیش‌نویسه.</p>
      </div>
    </div>
  </template>

  <!-- Open needs as cards. Fed only by ikiku.demand.ikiku_public_open(), which hands over
       plain public values, never the record: nothing here can print the business. -->
  <template id="job_cards" name="ایکیکو — کارتِ کارهای باز">
    <div t-if="jobs" class="ikiku__jobs">
      <t t-foreach="jobs" t-as="job">
        <article class="ikiku__job">
          <div class="ikiku__job-tags">
            <span t-if="job.get('seats')" class="ikiku__job-seats"><t t-out="job['seats']"/> نفر لازمه</span>
            <span t-if="job.get('work_type')" class="ikiku__job-type" t-out="job['work_type']"/>
          </div>
          <h3 t-out="job['position']"/>
          <p class="ikiku__job-where">
            <t t-out="job.get('province')"/><t t-if="job.get('city')">، <t t-out="job['city']"/></t></p>
          <p t-if="job.get('date_start_fa')" class="ikiku__job-when">
            از <span t-out="job['date_start_fa']"/>
            <t t-if="job.get('date_end_fa') == 'بدون پایان'"> · بدون پایان</t>
            <t t-else=""> تا <span t-out="job.get('date_end_fa')"/></t></p>
        </article>
      </t>
    </div>
    <div t-else="" class="ikiku__empty">
      هنوز کارِ بازی نیست. نیرو لازم دارید؟ <a href="/ku">اینجا بگید</a>.
    </div>
  </template>

  <template id="door_ki" name="ایکیکو — کی؟">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell ikiku__shell--narrow">
        <p class="ikiku__kicker">برای کسی که دنبالِ کاره</p>
        <h1 class="ikiku__ask">کی؟</h1>
        <p class="ikiku__plain">دنبالِ کار هستید؟</p>
        <ul class="ikiku__plainlist">
          <li>ظرف‌شستن، قهوه، آشپزی، گارسونی.</li>
          <li>حدودِ ۳ دقیقه طول می‌کشه.</li>
          <li>شماره و آدرس‌تون رو به هیچ‌کس نشون نمی‌دیم. <a href="/help/dide">چرا؟</a></li>
        </ul>
        <t t-if="otp_enabled">
          <a class="ikiku__go ikiku__go--block" t-att-href="start_url">شروع کنیم</a>
          <p class="ikiku__links"><a t-att-href="start_url">قبلاً ثبت‌نام کردم، وارد می‌شم</a>
            <a href="/help/kar">راهنما</a></p>
        </t>
        <t t-else="">
          <div class="ikiku__note">ثبت‌نام با پیامک الان کار نمی‌کنه. کمی بعد دوباره بیاید، یا
            <a href="/help/tamas?from=ki">بگید باهاتون تماس بگیریم</a>.</div>
          <p class="ikiku__links"><a href="/web/login">ورود با ایمیل</a></p>
        </t>
      </div></div>
    </t>
  </template>

  <template id="door_ku" name="ایکیکو — کو؟">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell ikiku__shell--narrow">
        <p class="ikiku__kicker">برای کافه و رستوران</p>
        <h1 class="ikiku__ask">کو؟</h1>
        <p class="ikiku__plain">برای کافه یا رستورانتون نیرو می‌خواید؟</p>
        <ul class="ikiku__plainlist">
          <li>بگید چه نیرویی، چند نفر، از کِی، کجا.</li>
          <li>ایکیکو از مزدِ کارگر چیزی برنمی‌داره. <a href="/help/hazine">هزینه‌ش چطوریه؟</a></li>
        </ul>
        <t t-if="otp_enabled">
          <a class="ikiku__go ikiku__go--block" t-att-href="start_url">شروع کنیم</a>
          <p class="ikiku__links"><a t-att-href="start_url">قبلاً ثبت‌نام کردم، وارد می‌شم</a>
            <a href="/help/niroo">راهنما</a></p>
        </t>
        <t t-else="">
          <div class="ikiku__note">ثبت‌نام با پیامک الان کار نمی‌کنه. کمی بعد دوباره بیاید، یا
            <a href="/help/tamas?from=ku">بگید باهاتون تماس بگیریم</a>.</div>
          <p class="ikiku__links"><a href="/web/login">ورود با ایمیل</a></p>
        </t>
      </div></div>
    </t>
  </template>

  <template id="manifest_page" name="ایکیکو — مرام‌نامه">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell ikiku__manifest">
        <p class="ikiku__note">متنِ کامل و رسمیِ قانونِ ایکیکو. <a href="/help/maram">خلاصه‌ی ساده‌اش اینجاست.</a></p>
        <t t-out="body"/>
      </div></div>
    </t>
  </template>

</odoo>
