<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- «قدم ۲ از ۵ · راهنما», and a bar that fills as the steps go by. -->
  <template id="step_head" name="سرِ قدم">
    <div class="ikiku__stephead">
      <span class="ikiku__step">
        <t t-if="edit">عوض کردن</t>
        <t t-else="">قدم <t t-out="request.env['ikiku.demand'].ikiku_fa_digits(step)"/> از <t t-out="request.env['ikiku.demand'].ikiku_fa_digits(total)"/></t>
      </span>
      <a class="ikiku__helplink" href="/help">راهنما</a>
    </div>
    <div t-if="not edit" class="ikiku__progress" role="presentation">
      <span t-att-style="'inline-size: ' + str(100 * step // total) + '%'"/>
    </div>
    <p t-if="for_business" class="ikiku__lead">برای <strong t-out="for_business"/>
      <a href="/business/need/for">مجموعه‌ی دیگه</a></p>
    <p t-if="changing_need" class="ikiku__notice">دارید درخواستی رو که قبلاً ثبت کردید عوض می‌کنید.
      <a href="/business">نمی‌خوام عوضش کنم</a></p>
  </template>

  <!-- Role tiles from the standard, grouped by family, in the published order. The featured
       roles are buttons; every other role of the family is one tap away under «کارهای دیگه»,
       which opens by itself when one of them is already chosen. -->
  <template id="skill_tiles" name="دکمه‌های کار">
    <t t-foreach="groups" t-as="group">
      <fieldset class="ikiku__group">
        <legend t-out="group[0].plain_label or group[0].name"/>
        <div class="ikiku__tiles">
          <t t-foreach="group[1]" t-as="node"><t t-call="ikiku_portal.role_tile"/></t>
        </div>
        <details t-if="group[2]" class="ikiku__more"
                 t-att-open="(group[2] &amp; group[2].browse(on_ids)) and 'open'">
          <summary>کارهای دیگه‌ی <t t-out="group[0].plain_label or group[0].name"/></summary>
          <t t-foreach="group[3]" t-as="part">
            <p t-if="part[0]" class="ikiku__label ikiku__subgroup" t-out="part[0].plain_label or part[0].name"/>
            <div class="ikiku__tiles">
              <t t-foreach="part[1]" t-as="node"><t t-call="ikiku_portal.role_tile"/></t>
            </div>
          </t>
        </details>
      </fieldset>
    </t>
  </template>

  <template id="role_tile" name="دکمه‌ی یک کار">
    <label class="ikiku__tile">
      <input t-att-type="input_type" name="node_id" t-att-value="node.id"
             t-att-checked="node.id in on_ids and 'checked'"
             t-att-disabled="node.id in locked_ids and 'disabled'"/>
      <span><t t-out="node.plain_label or node.name"/>
        <small t-if="node.id in locked_ids">ثبت شده</small></span>
    </label>
  </template>

  <!-- «از کِی؟» and «تا کِی؟» as buttons, with three selects for another day. -->
  <template id="date_choices" name="انتخابِ تاریخ">
    <fieldset class="ikiku__group">
      <legend>از کِی؟</legend>
      <div class="ikiku__chips">
        <t t-foreach="dates['starts']" t-as="choice">
          <label class="ikiku__chip">
            <input type="radio" name="start" t-att-value="choice[0]"
                   t-att-checked="dates['start'] == choice[0] and 'checked'"/>
            <span t-out="choice[1]"/>
          </label>
        </t>
        <label class="ikiku__chip">
          <input type="radio" name="start" value="custom" t-att-checked="dates['start'] == 'custom' and 'checked'"/>
          <span>یه روزِ دیگه…</span>
        </label>
      </div>
      <t t-call="ikiku_portal.date_selects"><t t-set="prefix" t-value="'start'"/></t>
    </fieldset>
    <fieldset class="ikiku__group">
      <legend>تا کِی؟</legend>
      <div class="ikiku__chips">
        <t t-foreach="dates['ends']" t-as="choice">
          <label class="ikiku__chip">
            <input type="radio" name="end" t-att-value="choice[0]"
                   t-att-checked="dates['end'] == choice[0] and 'checked'"/>
            <span t-out="choice[1]"/>
          </label>
        </t>
        <label class="ikiku__chip">
          <input type="radio" name="end" value="custom" t-att-checked="dates['end'] == 'custom' and 'checked'"/>
          <span>یه روزِ دیگه…</span>
        </label>
      </div>
      <t t-call="ikiku_portal.date_selects"><t t-set="prefix" t-value="'end'"/></t>
    </fieldset>
  </template>

  <template id="date_selects" name="روز، ماه، سال">
    <details class="ikiku__custom" t-att-open="dates['custom'].get(prefix) == 'custom' and 'open'">
      <summary>روزِ دیگه رو اینجا انتخاب کنید</summary>
      <div class="ikiku__selects">
        <label>روز
          <select class="ikiku__field" t-att-name="'%s_day' % prefix">
            <option value="">روز</option>
            <t t-foreach="dates['days']" t-as="d">
              <option t-att-value="d[0]" t-att-selected="dates['custom'].get('%s_day' % prefix) == str(d[0]) and 'selected'" t-out="d[1]"/>
            </t>
          </select>
        </label>
        <label>ماه
          <select class="ikiku__field" t-att-name="'%s_month' % prefix">
            <option value="">ماه</option>
            <t t-foreach="dates['months']" t-as="m">
              <option t-att-value="m[0]" t-att-selected="dates['custom'].get('%s_month' % prefix) == str(m[0]) and 'selected'" t-out="m[1]"/>
            </t>
          </select>
        </label>
        <label>سال
          <select class="ikiku__field" t-att-name="'%s_year' % prefix">
            <t t-foreach="dates['years']" t-as="y">
              <option t-att-value="y[0]" t-att-selected="dates['custom'].get('%s_year' % prefix) == str(y[0]) and 'selected'" t-out="y[1]"/>
            </t>
          </select>
        </label>
      </div>
    </details>
  </template>

  <!-- «کو؟», turning, with light running over it: what the page shows while it is fetching.
       The two letters are the logo's own (ikiku-icon.svg), so waiting looks like iKiKu and not
       like a borrowed spinner. The widget shows it only when an answer takes longer than a
       blink (search_suggest's BUSY_AFTER), so a fast answer never flickers it. Decorative:
       the words next to it ("هنوز دنبالِ بقیه‌ام…") are what a screen reader hears. -->
  <template id="ku_spinner" name="کو، در حال گشتن">
    <span class="ikiku-ku-spinner" aria-hidden="true" t-att-data-suggest-busy="busy_slot and '1'">
      <svg viewBox="30 38 296 228" width="28" height="22" focusable="false">
        <defs>
          <linearGradient t-att-id="spinner_id or 'ikiku-ku-light'" gradientUnits="userSpaceOnUse"
                          x1="0" y1="0" x2="330" y2="0">
            <stop offset="0" stop-color="currentColor"/>
            <stop offset="0.42" stop-color="currentColor"/>
            <stop offset="0.5" stop-color="#ffffff" stop-opacity="0.95"/>
            <stop offset="0.58" stop-color="currentColor"/>
            <stop offset="1" stop-color="currentColor"/>
            <animateTransform attributeName="gradientTransform" type="translate"
                              values="-330 0; 330 0" dur="1.1s" repeatCount="indefinite"/>
          </linearGradient>
        </defs>
        <g t-att-fill="'url(#%s)' % (spinner_id or 'ikiku-ku-light')" fill-rule="evenodd">
          <path d="M175 48L316 48L316 89L212 89L280 157L280 199L134 199L134 158L208 158L137 86z"/>
          <path d="M50 115 H120 V256 H58 V215 H50 A50 50 0 0 1 50 115 Z M44 165 a12 12 0 1 0 24 0 a12 12 0 1 0 -24 0 z"/>
        </g>
      </svg>
    </span>
  </template>

  <!-- Province first, nothing chosen for the person; the city is typed.
       The box asks the place responder when one is configured (place_suggest_url) and falls
       back to Odoo's own endpoint when it does not answer; the ranking is the same in both. -->
  <template id="place_fields" name="جا">
    <label for="place_q" class="ikiku__label">کجا؟</label>
    <div data-suggest="" t-att-data-suggest-url="place_suggest_url or '/places/suggest'"
         t-att-data-suggest-fallback="place_suggest_fallback or None"
         data-suggest-target="place_id" data-suggest-missed="place_missed"
         data-suggest-min="2" data-suggest-count="{n} جا پیدا شد"
         data-suggest-waiting="هنوز دنبالِ بقیه‌ام…"
         t-att-data-suggest-kinds="ask_postcode and 'all' or 'city'">
      <input class="ikiku__field ikiku__field--big" id="place_q" name="place_q" type="search"
             t-att-value="place_q" required="required" autocomplete="off"
             t-att-placeholder="ask_postcode and 'مثلاً: فلسطین، تهران' or 'مثلاً: کرج'"
             t-att-aria-invalid="errors_place and 'true'"/>
      <t t-call="ikiku_portal.ku_spinner">
        <t t-set="busy_slot" t-value="True"/>
        <t t-set="spinner_id" t-value="'ikiku-ku-light-place'"/>
      </t>
    </div>
    <!-- The last text that found nothing: if a place is picked after it, an editor is asked
         whether it is another name for that place. Never a post code (see _suggest_missed). -->
    <input type="hidden" name="place_missed" t-att-value="place_missed"/>
    <input type="hidden" name="place_id" t-att-value="place_id"/>
    <p t-if="place_path" class="ikiku__hint">الان: <t t-out="place_path"/></p>
    <p t-if="not ask_postcode" class="ikiku__hint">شهر کافیه. آدرسِ خونه رو نمی‌خوایم.</p>

    <!-- The text matched more than one place: the person says which, and the form works
         without JavaScript because this is an ordinary group of radio buttons. -->
    <fieldset t-if="place_candidates" class="ikiku__choices">
      <legend class="ikiku__label">کدومش؟</legend>
      <t t-foreach="place_candidates" t-as="candidate">
        <label class="ikiku__choice">
          <input type="radio" name="place_id" t-att-value="candidate.id"/>
          <span t-out="candidate.path"/>
        </label>
      </t>
    </fieldset>

    <t t-if="ask_postcode">
      <label for="postcode" class="ikiku__label">یا کد پستی (اختیاری)</label>
      <input class="ikiku__field" id="postcode" name="postcode" inputmode="numeric"
             autocomplete="postal-code" placeholder="مثلاً: ۱۴۱۶۷۵۳۹۵۵"/>
      <p class="ikiku__hint">از کد پستی فقط پنج رقمِ اولش رو نگه می‌داریم، که محله رو نشون میده.
        خودِ کد پستی جایی ذخیره نمیشه.</p>
    </t>
    <p t-if="errors_place" class="ikiku__error" role="alert" t-out="errors_place"/>
  </template>

</odoo>
