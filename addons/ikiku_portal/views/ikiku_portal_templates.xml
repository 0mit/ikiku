<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ============================================================ workers (کی؟) -->

  <template id="join_name" name="اسم">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell ikiku__shell--narrow">
        <t t-if="not for_business" t-call="ikiku_portal.step_head"/>
        <h1 class="ikiku__question">اسمتون چیه؟</h1>
        <form method="post" class="ikiku__form" data-ikiku-form="">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
          <input t-if="for_business" type="hidden" name="for" value="ku"/>
          <input t-if="edit" type="hidden" name="edit" value="1"/>
          <label for="name" class="ikiku__label">اسم و فامیل</label>
          <input class="ikiku__field ikiku__field--big" id="name" name="name" t-att-value="name"
                 placeholder="مثلاً: رضا محمدی" autocomplete="name" maxlength="120" required="required"
                 t-att-aria-invalid="error and 'true'" t-att-aria-describedby="'name-error' if error else 'name-help'"/>
          <p t-if="error" id="name-error" class="ikiku__error" role="alert" t-out="error"/>
          <p id="name-help" class="ikiku__lead">
            <t t-if="for_business">این اسمِ خودتونه، نه اسمِ کافه یا رستوران. اسمِ مجموعه رو بعدش می‌پرسیم.</t>
            <t t-else="">این اسم روی صفحه‌ی کاری‌تون دیده میشه. شماره و آدرس‌تون دیده نمیشه.</t>
          </p>
          <button class="ikiku__go ikiku__go--block" type="submit">ادامه</button>
        </form>
      </div></div>
    </t>
  </template>

  <template id="join_where" name="کجا">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell ikiku__shell--narrow">
        <t t-call="ikiku_portal.step_head"/>
        <h1 class="ikiku__question">کدوم استان و کدوم شهر؟</h1>
        <p class="ikiku__lead">آدرسِ خونه رو نمی‌خوایم. فقط شهر.</p>
        <p t-if="has_business" class="ikiku__lead">اینجا شهرِ خودتونه که توش دنبالِ کار می‌گردید. شهرِ مجموعه‌تون عوض نمیشه.</p>
        <form method="post" class="ikiku__form" data-ikiku-form="">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
          <input t-if="edit" type="hidden" name="edit" value="1"/>
          <t t-call="ikiku_portal.place_fields"/>
          <t t-call="ikiku_portal.area_field"/>
          <button class="ikiku__go ikiku__go--block" type="submit">ادامه</button>
        </form>
      </div></div>
    </t>
  </template>

  <!-- A person's neighbourhood: asked only as something they may CHOOSE to show (بند ۷ —
       هر کس خودش تصمیم می‌گیرد). Empty, only the city is kept and shown. -->
  <template id="area_field" name="محله، اگر بخواهید">
    <label for="place_area_q" class="ikiku__label">محله (اختیاری)</label>
    <p class="ikiku__hint">فقط اگه می‌خواید کسب‌وکارها ببینن کدوم محلهٔ شهرتون هستید. آدرسِ خونه نه؛ اسمِ محله کافیه.
      خالی بذارید تا فقط شهرتون دیده بشه.</p>
    <div data-suggest="" t-att-data-suggest-url="place_suggest_url or '/places/suggest'"
         t-att-data-suggest-fallback="place_suggest_fallback or None"
         data-suggest-target="place_area_id" data-suggest-min="2" data-suggest-count="{n} محله پیدا شد"
         data-suggest-waiting="هنوز دنبالِ بقیه‌ام…" data-suggest-via="از راهِ {via}"
         data-suggest-kinds="neighbourhood,district" t-att-data-suggest-within="area_within or None">
      <input class="ikiku__field" id="place_area_q" name="place_area_q" type="search"
             t-att-value="place_area_q" autocomplete="off" placeholder="مثلاً: نارمک"
             t-att-aria-invalid="errors_area and 'true'"/>
      <t t-call="ikiku_portal.ku_spinner">
        <t t-set="busy_slot" t-value="True"/>
        <t t-set="spinner_id" t-value="'ikiku-ku-light-area'"/>
      </t>
    </div>
    <input type="hidden" name="place_area_id" t-att-value="place_area_id"/>
    <p t-if="errors_area" class="ikiku__error" role="alert" t-out="errors_area"/>
  </template>

  <template id="join_skills" name="چه کاری بلدید">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell">
        <t t-call="ikiku_portal.step_head"/>
        <h1 class="ikiku__question">چه کارهایی بلدید؟</h1>
        <p class="ikiku__lead">هر چند تا که بلدید بزنید.</p>
        <p t-if="error" class="ikiku__error" role="alert" t-out="error"/>
        <t t-call="ikiku_portal.role_pick"/>

        <form method="post" class="ikiku__form" data-ikiku-form="">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
          <input t-if="edit" type="hidden" name="edit" value="1"/>
          <t t-call="ikiku_portal.skill_tiles">
            <t t-set="input_type" t-value="'checkbox'"/>
            <t t-set="on_ids" t-value="claimed.ids"/>
            <t t-set="locked_ids" t-value="claimed.ids"/>
          </t>
          <p class="ikiku__lead">این رو خودتون می‌گید. بعداً کسانی که باهاتون کار کردن می‌تونن تأییدش کنن.</p>
          <button class="ikiku__go ikiku__go--block" type="submit">ادامه</button>
        </form>

        <details class="ikiku__more" t-att-open="raw and 'open'">
          <summary>کارتون اینجا نیست؟ خودتون بنویسید</summary>
          <form method="get" class="ikiku__form">
            <input t-if="edit" type="hidden" name="edit" value="1"/>
            <label for="raw" class="ikiku__label">چه کاری بلدید؟</label>
            <input class="ikiku__field ikiku__field--big" id="raw" name="raw" t-att-value="raw"
                   placeholder="مثلاً: سبزی پاک می‌کنم و سالاد درست می‌کنم"/>
            <button class="ikiku__secondary" type="submit">بگرد</button>
          </form>
          <t t-if="proposals is not None">
            <t t-if="proposals">
              <p class="ikiku__lead">منظورتون یکی از این‌هاست؟</p>
              <ul class="ikiku__proposals">
                <t t-foreach="proposals" t-as="node">
                  <li class="ikiku__proposal">
                    <span t-out="node.plain_label or node.name"/>
                    <form method="post">
                      <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                      <input type="hidden" name="raw" t-att-value="raw"/>
                      <input type="hidden" name="node_id" t-att-value="node.id"/>
                      <input t-if="edit" type="hidden" name="edit" value="1"/>
                      <button type="submit">آره، همینه</button>
                    </form>
                  </li>
                </t>
              </ul>
            </t>
            <form method="post" class="ikiku__form">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
              <input type="hidden" name="raw" t-att-value="raw"/>
              <input t-if="edit" type="hidden" name="edit" value="1"/>
              <p class="ikiku__lead">نوشته‌تون رو نگه می‌داریم. اگه چند نفرِ دیگه هم همین رو بنویسن،
                تیمِ ایکیکو نگاه می‌کنه که به فهرست اضافه بشه.</p>
              <button class="ikiku__secondary" type="submit">
                <t t-if="proposals">هیچ‌کدوم؛ همین نوشته رو نگه دارید</t><t t-else="">همین نوشته رو نگه دارید</t></button>
            </form>
          </t>
        </details>
      </div></div>
    </t>
  </template>

  <template id="join_when" name="از کِی تا کِی">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell">
        <t t-call="ikiku_portal.step_head"/>
        <h1 class="ikiku__question">از کِی تا کِی می‌تونید کار کنید؟</h1>
        <p t-if="error" class="ikiku__error" role="alert" t-out="error"/>
        <form method="post" class="ikiku__form" data-ikiku-form="">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
          <input t-if="edit" type="hidden" name="edit" value="1"/>
          <t t-call="ikiku_portal.date_choices"/>
          <p class="ikiku__lead">این تاریخ‌ها روی صفحه‌ای که همه می‌بینن نمیاد.
            <a href="/help/dide">چرا؟</a></p>
          <button class="ikiku__go ikiku__go--block" type="submit">ادامه</button>
        </form>
      </div></div>
    </t>
  </template>

  <template id="join_how" name="چه جوری">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell">
        <t t-call="ikiku_portal.step_head"/>
        <h1 class="ikiku__question">چه جوری می‌خواید کار کنید؟</h1>
        <form method="post" class="ikiku__form" data-ikiku-form="">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
          <input t-if="edit" type="hidden" name="edit" value="1"/>

          <fieldset class="ikiku__group">
            <legend>هر کدوم که قبول دارید بزنید</legend>
            <div class="ikiku__tiles">
              <t t-foreach="work_types" t-as="wt">
                <label class="ikiku__tile">
                  <input type="checkbox" name="work_type_id" t-att-value="wt.id"
                         t-att-checked="wt in selected_types and 'checked'"/>
                  <span><t t-out="wt.name"/><small t-out="wt.description"/></span>
                </label>
              </t>
            </div>
            <p t-if="errors.get('types')" class="ikiku__error" role="alert" t-out="errors['types']"/>
          </fieldset>

          <fieldset class="ikiku__group">
            <legend>چه ساعتی؟ (لازم نیست)</legend>
            <div class="ikiku__chips">
              <t t-foreach="shifts" t-as="shift">
                <label class="ikiku__chip">
                  <input type="checkbox" name="shift_id" t-att-value="shift.id"
                         t-att-checked="shift in selected_shifts and 'checked'"/>
                  <span t-out="shift.name.replace('شیفت ', '')"/>
                </label>
              </t>
            </div>
          </fieldset>

          <fieldset class="ikiku__group">
            <legend>اگه کار تو یه شهرِ دیگه باشه، می‌رید؟</legend>
            <div class="ikiku__chips">
              <label class="ikiku__chip"><input type="radio" name="relocate" value="yes"
                     t-att-checked="relocate == 'yes' and 'checked'"/><span>آره</span></label>
              <label class="ikiku__chip"><input type="radio" name="relocate" value="no"
                     t-att-checked="relocate == 'no' and 'checked'"/><span>نه</span></label>
            </div>
            <p t-if="errors.get('relocate')" class="ikiku__error" role="alert" t-out="errors['relocate']"/>
          </fieldset>

          <button class="ikiku__go ikiku__go--block" type="submit">ثبت کن</button>
        </form>
      </div></div>
    </t>
  </template>

  <template id="resource_home" name="صفحه‌ی من">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell">
        <t t-if="len(sides) == 2" t-call="ikiku_portal.side_switch"><t t-set="side" t-value="'ki'"/></t>
        <p class="ikiku__step">صفحه‌ی من</p>
        <h1 class="ikiku__question" t-out="partner.name"/>

        <div t-if="next_step" class="ikiku__status ikiku__status--todo">
          <p>هنوز تموم نشده. یه قدم مونده.</p>
          <a class="ikiku__go" t-att-href="next_step">ادامه</a>
        </div>
        <div t-elif="resource.state == 'submitted'" class="ikiku__status">
          ثبت شد. تیمِ ایکیکو نگاهش می‌کنه. لازم نیست کاری بکنید.
        </div>
        <div t-elif="resource.state == 'active'" class="ikiku__status">
          صفحه‌ی کاری‌تون بازه و همه می‌بینن.
          <a t-att-href="'/p/%s' % resource.slug">صفحه‌ای که همه می‌بینن</a>
        </div>
        <div t-elif="resource.state == 'paused'" class="ikiku__status">
          صفحه‌تون فعلاً خاموشه.
          <a t-att-href="'/p/%s' % resource.slug">صفحه‌ای که همه می‌بینن</a>
        </div>

        <dl class="ikiku__summary">
          <div><dt>اسم</dt><dd t-out="partner.name"/><a href="/join/name?edit=1">عوض کنید</a></div>
          <div><dt>استان و شهر</dt>
            <dd><t t-out="partner.ikiku_province_id.name"/><t t-if="partner.ikiku_city">، <t t-out="partner.ikiku_city"/></t></dd>
            <a href="/join/where?edit=1">عوض کنید</a></div>
          <div><dt>کارهایی که بلدید</dt>
            <dd t-out="skills_text or 'هنوز نگفتید'"/>
            <a href="/join/skills?edit=1">اضافه کنید</a></div>
          <div><dt>از کِی تا کِی</dt><dd t-out="dates_text or 'هنوز نگفتید'"/>
            <a href="/join/when?edit=1">عوض کنید</a></div>
          <div><dt>چه جوری</dt>
            <dd t-if="availability and availability.details_confirmed">
              <t t-out="'، '.join(availability.work_type_ids.mapped('name'))"/>
              <t t-if="availability.can_relocate"> · شهرِ دیگه هم می‌رید</t></dd>
            <dd t-else="">هنوز نگفتید</dd>
            <a href="/join/how?edit=1">عوض کنید</a></div>
        </dl>

        <section class="ikiku__card">
          <h2 class="ikiku__subhead">اعتبار: <t t-out="standing"/> از <t t-out="standing_max"/></h2>
          <p t-if="standing_verified">هویتِ تأییدشده: <t t-out="standing_verified"/></p>
          <p><t t-out="supported_count"/> چیز که گفتید و یکی دیگه تأییدش کرد، هر کدوم <t t-out="per_supported"/></p>
          <p><a href="/help/etebar">این عدد از کجا میاد؟</a></p>
        </section>

        <t t-call="ikiku_portal.my_number"/>

        <section>
          <h2 class="ikiku__subhead">قرارهای کارِ من</h2>
          <t t-if="bookings">
            <t t-foreach="bookings" t-as="b">
              <div class="ikiku__card">
                <strong t-out="b.public_ref"/> · از <span t-out="b.date_start_fa"/> تا <span t-out="b.date_end_fa"/>
                <div class="ikiku__muted" t-out="b.employer_business_id.name"/>
              </div>
            </t>
          </t>
          <p t-else="" class="ikiku__lead">هنوز قرارِ کاری ندارید.</p>
        </section>

        <p t-if="'ku' not in sides" class="ikiku__lead">کافه یا رستوران هم دارید؟ <a href="/ku">با همین شماره همکار بخواید</a></p>
        <p class="ikiku__links"><a href="/help">راهنما</a> <a href="/web/session/logout?redirect=/">خروج</a></p>
      </div></div>
    </t>
  </template>

  <!-- ============================================================ businesses (کو؟) -->

  <template id="business_name" name="اسمِ کافه یا رستوران">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell ikiku__shell--narrow">
        <p class="ikiku__step"><t t-if="business">عوض کردن</t><t t-elif="another">مجموعه‌ی دیگه</t><t t-else="">شروع</t></p>
        <h1 t-if="another" class="ikiku__question">اسمِ کافه یا رستورانِ دیگه‌تون چیه؟</h1>
        <h1 t-else="" class="ikiku__question">اسمِ کافه یا رستورانتون چیه؟</h1>
        <p class="ikiku__lead">همون اسمی که سرِ در نوشته.</p>
        <p t-if="has_resource and not business" class="ikiku__lead">صفحه‌ی کاری‌تون سرِ جاشه. این فقط برای مجموعه‌تونه.</p>
        <form method="post" class="ikiku__form" data-ikiku-form="">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
          <label for="name" class="ikiku__label">اسمِ کافه یا رستوران</label>
          <input class="ikiku__field ikiku__field--big" id="name" name="name" t-att-value="name" maxlength="120"
                 placeholder="مثلاً: کافه نارنج" autocomplete="organization" required="required"
                 t-att-aria-invalid="error and 'true'"/>
          <p t-if="error" class="ikiku__error" role="alert" t-out="error"/>
          <p class="ikiku__lead">اسمِ مجموعه‌تون تو فهرستِ «کارهای باز» نمیاد.</p>
          <button class="ikiku__go ikiku__go--block" type="submit">ادامه</button>
        </form>
      </div></div>
    </t>
  </template>

  <template id="need_who" name="برای چه کاری">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell">
        <t t-call="ikiku_portal.step_head"><t t-set="edit" t-value="False"/></t>
        <h1 class="ikiku__question">برای چه کاری همکار لازم دارید؟</h1>
        <p t-if="error" class="ikiku__error" role="alert" t-out="error"/>
        <t t-call="ikiku_portal.role_pick"/>
        <form method="post" class="ikiku__form" data-ikiku-form="">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
          <t t-call="ikiku_portal.skill_tiles">
            <t t-set="input_type" t-value="'radio'"/>
            <t t-set="on_ids" t-value="[selected] if selected else []"/>
            <t t-set="locked_ids" t-value="[]"/>
          </t>
          <button class="ikiku__go ikiku__go--block" type="submit">ادامه</button>
        </form>
        <details class="ikiku__more" t-att-open="raw and 'open'">
          <summary>اینجا نیست؟ همون‌جوری که به همکارتون می‌گید بنویسید</summary>
          <form method="get" class="ikiku__form">
            <label for="raw" class="ikiku__label">چه کسی رو لازم دارید؟</label>
            <input class="ikiku__field ikiku__field--big" id="raw" name="raw" t-att-value="raw"
                   placeholder="مثلاً: یکی که ظرف بشوره و شیفتِ شب وایسه"/>
            <button class="ikiku__secondary" type="submit">بگرد</button>
          </form>
          <t t-if="proposals is not None">
            <t t-if="proposals">
              <p class="ikiku__lead">منظورتون اینه؟</p>
              <ul class="ikiku__proposals">
                <t t-foreach="proposals" t-as="node">
                  <li class="ikiku__proposal">
                    <span t-out="node.plain_label or node.name"/>
                    <form method="post">
                      <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                      <input type="hidden" name="raw" t-att-value="raw"/>
                      <input type="hidden" name="node_id" t-att-value="node.id"/>
                      <button type="submit">آره، همینه</button>
                    </form>
                  </li>
                </t>
              </ul>
            </t>
            <p t-else="" class="ikiku__lead">این رو نفهمیدیم. از دکمه‌های بالا نزدیک‌ترین رو بزنید؛
              نوشته‌تون هم نگه داشته میشه.</p>
          </t>
        </details>
      </div></div>
    </t>
  </template>

  <template id="need_type" name="چه جور کاری">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell ikiku__shell--narrow">
        <t t-call="ikiku_portal.step_head"><t t-set="edit" t-value="False"/></t>
        <h1 class="ikiku__question">چه جور کاری؟</h1>
        <form method="post" class="ikiku__form" data-ikiku-form="">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
          <fieldset class="ikiku__group">
            <legend class="ikiku__sr">نوعِ همکاری</legend>
            <div class="ikiku__tiles ikiku__tiles--one">
              <t t-foreach="work_types" t-as="wt">
                <label class="ikiku__tile">
                  <input type="radio" name="work_type_id" t-att-value="wt.id"
                         t-att-checked="wt.id == selected and 'checked'"/>
                  <span><t t-out="wt.name"/><small t-out="wt.description"/></span>
                </label>
              </t>
            </div>
          </fieldset>
          <p t-if="error" class="ikiku__error" role="alert" t-out="error"/>
          <button class="ikiku__go ikiku__go--block" type="submit">ادامه</button>
        </form>
      </div></div>
    </t>
  </template>

  <template id="need_count" name="چند نفر">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell ikiku__shell--narrow">
        <t t-call="ikiku_portal.step_head"><t t-set="edit" t-value="False"/></t>
        <h1 class="ikiku__question">چند نفر لازم دارید؟</h1>
        <form method="post" class="ikiku__form ikiku__form--stepper">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
          <!-- First in the form so the Enter key means «ادامه», not «−»; CSS shows it last. -->
          <button class="ikiku__go ikiku__go--block ikiku__last" type="submit" name="next" value="1">ادامه</button>
          <div class="ikiku__stepper">
            <button type="submit" name="adjust" value="-1" class="ikiku__stepper-btn" aria-label="یکی کمتر">−</button>
            <label for="seats" class="ikiku__sr">تعداد نفر</label>
            <input class="ikiku__field ikiku__stepper-value" id="seats" name="seats" t-att-value="seats_fa"
                   inputmode="numeric" dir="ltr" maxlength="3"/>
            <button type="submit" name="adjust" value="1" class="ikiku__stepper-btn" aria-label="یکی بیشتر">+</button>
          </div>
          <p t-if="error" class="ikiku__error" role="alert" t-out="error"/>
        </form>
      </div></div>
    </t>
  </template>

  <template id="need_when" name="از کِی تا کِی لازمشون دارید">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell">
        <t t-call="ikiku_portal.step_head"><t t-set="edit" t-value="False"/></t>
        <h1 class="ikiku__question">از کِی تا کِی لازمشون دارید؟</h1>
        <p class="ikiku__lead">زودتر بگید، آدم‌های بیشتری پیدا میشن.</p>
        <p t-if="error" class="ikiku__error" role="alert" t-out="error"/>
        <form method="post" class="ikiku__form" data-ikiku-form="">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
          <t t-call="ikiku_portal.date_choices"/>
          <button class="ikiku__go ikiku__go--block" type="submit">ادامه</button>
        </form>
      </div></div>
    </t>
  </template>

  <template id="need_where" name="کجا و بررسی">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell ikiku__shell--narrow">
        <t t-call="ikiku_portal.step_head"><t t-set="edit" t-value="False"/></t>
        <h1 class="ikiku__question">کجا؟ همه درسته؟</h1>
        <dl class="ikiku__summary">
          <div><dt>چه کاری</dt><dd t-out="summary['who']"/><a href="/business/need/who">عوض کنید</a></div>
          <div><dt>چه جور</dt><dd t-out="summary['type']"/><a href="/business/need/type">عوض کنید</a></div>
          <div><dt>چند نفر</dt><dd><t t-out="summary['seats']"/> نفر</dd><a href="/business/need/count">عوض کنید</a></div>
          <div><dt>کِی</dt><dd t-out="summary['dates']"/><a href="/business/need/when">عوض کنید</a></div>
        </dl>
        <form method="post" class="ikiku__form" data-ikiku-form="">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
          <p t-if="has_resource" class="ikiku__lead">این شهرِ کافه یا رستورانه. شهری که خودتون توش دنبالِ کار می‌گردید عوض نمیشه.</p>
          <t t-call="ikiku_portal.place_fields"/>
          <p class="ikiku__notice">این درخواست تو «کارهای باز» دیده میشه: چه کاری، چه جور، چند نفر، کدوم
            استان و شهر، از کِی تا کِی. اسمِ مجموعه‌تون دیده نمیشه.</p>
          <p t-if="changing_need" class="ikiku__lead">کسانی که قبلاً براتون پیدا شده بودن دوباره از نو گشته میشن، چون تاریخ یا جا یا کار ممکنه عوض شده باشه.</p>
          <button class="ikiku__go ikiku__go--block" type="submit"><t t-if="changing_need">تغییرها رو ثبت کن</t><t t-else="">ثبت کن</t></button>
        </form>
      </div></div>
    </t>
  </template>

  <template id="need_saved" name="درخواست ثبت شد">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell ikiku__shell--narrow">
        <p class="ikiku__step">ثبت شد</p>
        <h1 class="ikiku__question" t-if="is_open">درخواستتون ثبت شد.</h1>
        <h1 class="ikiku__question" t-elif="demand.state == 'filled'">این درخواست بسته شد: همکار پیدا کردید.</h1>
        <h1 class="ikiku__question" t-else="">این درخواست لغو شد.</h1>
        <dl class="ikiku__summary">
          <div><dt>چه کاری</dt><dd t-out="demand.position_id.spec_node_id.plain_label or demand.position_id.spec_node_id.name"/></div>
          <div><dt>چه جور</dt><dd t-out="demand.work_type_id.name"/></div>
          <div><dt>چند نفر</dt><dd><t t-out="seats"/> نفر</dd></div>
          <div><dt>کِی</dt><dd t-out="dates"/></div>
          <div><dt>کجا</dt><dd><t t-out="demand.province_id.name"/><t t-if="demand.city">، <t t-out="demand.city"/></t></dd></div>
        </dl>
        <t t-if="is_open">
          <p class="ikiku__lead">تو «کارهای باز» اومد، بدونِ اسمِ مجموعه‌تون.</p>
          <p class="ikiku__lead">ایکیکو کسانی رو که تو این تاریخ‌ها و این استان آزادن نگاه می‌کنه.</p>
        </t>
        <t t-call="ikiku_portal.need_actions"><t t-set="need_rec" t-value="demand"/></t>
        <p class="ikiku__links">
          <a class="ikiku__go" href="/business">درخواست‌های من</a>
          <a href="/help/hazine">هزینه‌ش چطوریه؟</a>
          <a href="/help/tamas?from=need">می‌خوام یکی باهام تماس بگیره</a>
        </p>
      </div></div>
    </t>
  </template>

  <template id="business_home" name="درخواست‌های من">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell">
        <t t-if="len(sides) == 2" t-call="ikiku_portal.side_switch"><t t-set="side" t-value="'ku'"/></t>
        <p t-if="len(businesses) == 1" class="ikiku__step" t-out="businesses[0]['business'].name"/>
        <p t-else="" class="ikiku__step">کافه‌ها و رستوران‌هاتون</p>
        <h1 class="ikiku__question">درخواست‌هاتون</h1>
        <p t-if="note" class="ikiku__status" role="status" t-out="note"/>
        <!-- One section per business (operator, 2026-09-16: one person may hold several). -->
        <t t-foreach="businesses" t-as="row">
          <t t-set="biz" t-value="row['business']"/>
          <section class="ikiku__biz">
            <div t-if="len(businesses) &gt; 1" class="ikiku__biz-head">
              <h2 class="ikiku__subhead" t-out="biz.name"/>
              <a t-att-href="'/business/name?business=%d' % biz.id">عوض کردنِ اسم</a>
            </div>
            <a class="ikiku__go ikiku__go--block" t-att-href="'/business/need/new?business=%d' % biz.id">
              <t t-if="len(businesses) &gt; 1">همکارِ تازه برای <t t-out="biz.name"/></t>
              <t t-else="">همکارِ تازه می‌خوام</t>
            </a>
            <div t-if="row['needs']" class="ikiku__needs">
              <t t-foreach="row['needs']" t-as="need">
                <t t-set="d" t-value="need['demand']"/>
                <article class="ikiku__card ikiku__need">
                  <strong><t t-out="need['seats']"/> نفر · <t t-out="d.position_id.spec_node_id.plain_label or d.position_id.spec_node_id.name"/></strong>
                  <p><t t-out="d.work_type_id.name"/> · <t t-out="need['dates']"/></p>
                  <p class="ikiku__muted"><t t-out="d.province_id.name"/><t t-if="d.city">، <t t-out="d.city"/></t>
                    · <t t-out="{'draft': 'پیش‌نویس', 'open': 'باز', 'proposed': 'باز', 'filled': 'همکار پیدا شد', 'cancelled': 'لغو شد'}.get(d.state)"/></p>
                  <t t-call="ikiku_portal.need_actions">
                    <t t-set="need_rec" t-value="d"/>
                    <t t-set="is_open" t-value="need['is_open']"/><t t-set="booked" t-value="need['booked']"/>
                  </t>
                </article>
              </t>
            </div>
            <p t-else="" class="ikiku__lead">هنوز درخواستی ندارید.</p>
          </section>
        </t>
        <p class="ikiku__lead ikiku__biz-add">یه کافه یا رستورانِ دیگه هم دارید؟ <a href="/business/name?new=1">اضافه‌ش کنید</a></p>
        <t t-call="ikiku_portal.my_number"/>
        <p t-if="'ki' not in sides" class="ikiku__lead">خودتون هم دنبالِ کار هستید؟ <a href="/ki">با همین شماره ثبت‌نام کنید</a></p>
        <p class="ikiku__links">
          <a t-if="len(businesses) == 1" href="/business/name">عوض کردنِ اسم</a>
          <a href="/help/niroo">راهنما</a>
          <a href="/web/session/logout?redirect=/">خروج</a>
        </p>
      </div></div>
    </t>
  </template>

  <!-- ============================================================ one account, two sides -->

  <!-- /my for a person with both sides who has not opened either in this browser. -->
  <template id="choose_side" name="امروز برای چی اومدید">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell ikiku__shell--narrow">
        <p class="ikiku__step">صفحه‌ی من</p>
        <h1 class="ikiku__question">امروز برای چی اومدید؟</h1>
        <div class="ikiku__tiles ikiku__tiles--one">
          <a class="ikiku__tile ikiku__tile--link" href="/me"><span>کار می‌خوام<small>صفحه‌ی کاریِ خودتون</small></span></a>
          <a class="ikiku__tile ikiku__tile--link" href="/business"><span>همکار می‌خوام<small t-if="len(businesses) == 1">درخواست‌های <t t-out="businesses.name"/></small><small t-else="">درخواست‌های مجموعه‌هاتون</small></span></a>
        </div>
        <p class="ikiku__lead">هر وقت خواستید، بالای صفحه عوضش کنید.</p>
        <p class="ikiku__links"><a href="/help/hardo">راهنما</a> <a href="/web/session/logout?redirect=/">خروج</a></p>
      </div></div>
    </t>
  </template>

  <!-- On /me and /business when the account holds both sides. On the page, not only in the
       menu: on a phone the menu is folded away. -->
  <template id="side_switch" name="کار یا همکار">
    <nav class="ikiku__switch" aria-label="کار می‌خوام یا همکار می‌خوام">
      <a href="/me" t-att-class="'is-on' if side == 'ki' else None" t-att-aria-current="'page' if side == 'ki' else None">کار می‌خوام</a>
      <a href="/business" t-att-class="'is-on' if side == 'ku' else None" t-att-aria-current="'page' if side == 'ku' else None">همکار می‌خوام</a>
    </nav>
  </template>

  <!-- The person's own number, masked: it is the number they sign in with and the one staff
       call. The whole number is never in the page. -->
  <template id="my_number" name="شماره‌ی شما">
    <section class="ikiku__card ikiku__number">
      <h2 class="ikiku__subhead">شماره موبایلِ شما</h2>
      <t t-if="number['masked']">
        <p><bdi dir="ltr" t-out="number['masked']"/> ·
          <t t-if="number['proven']">تأیید شده</t><t t-else="">هنوز تأیید نشده</t></p>
      </t>
      <p t-else="">هنوز شماره‌ای ثبت نکردید.</p>
      <p class="ikiku__lead">با همین شماره وارد میشید. فقط تیمِ ایکیکو می‌بینه‌ش؛ هیچ کس دیگه‌ای نمی‌بینه.</p>
      <p t-if="not number['proven'] and number['can_prove']"><a class="ikiku__go" href="/enter">تأیید با کدِ پیامک</a></p>
      <p><a href="/help/shomare">شماره‌تون عوض شده؟</a></p>
    </section>
  </template>

  <!-- ============================================================ changing and closing a need -->

  <!-- Under each need. Open and not booked: change it, or say it is no longer needed.
       Booked: staff only, because a booking is public (بند ۷, D-16 A). -->
  <template id="need_actions" name="عوض کردن یا بستنِ درخواست">
    <p t-if="is_open and not booked" class="ikiku__links">
      <a t-att-href="'/business/need/%d/edit' % need_rec.id">عوض کنید</a>
      <a t-att-href="'/business/need/%d/close' % need_rec.id">دیگه لازم ندارم</a>
    </p>
    <p t-elif="is_open" class="ikiku__lead">برای این درخواست قرارِ کار بسته شده. برای عوض کردن یا لغوش
      <a t-att-href="'/help/tamas?from=need-%d' % need_rec.id">بگید باهاتون تماس بگیریم</a>.</p>
    <p t-elif="need_rec.state == 'cancelled'" class="ikiku__muted">دلیلِ لغو: <t t-out="need_rec.cancel_reason"/></p>
  </template>

  <template id="need_close" name="دیگه لازم ندارم">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell ikiku__shell--narrow">
        <p class="ikiku__step">بستنِ درخواست</p>
        <h1 class="ikiku__question">چرا دیگه لازم ندارید؟</h1>
        <p class="ikiku__lead"><t t-out="seats"/> نفر · <t t-out="demand.position_id.spec_node_id.plain_label or demand.position_id.spec_node_id.name"/></p>
        <form method="post" class="ikiku__form" data-ikiku-form="">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
          <input type="hidden" name="outcome" value="found"/>
          <button class="ikiku__go ikiku__go--block" type="submit">همکار پیدا کردم</button>
        </form>
        <a class="ikiku__secondary ikiku__go--block" t-att-href="'/business/need/%d/cancel' % demand.id">لغو می‌کنم</a>
        <p class="ikiku__lead">درخواست پاک نمیشه؛ فقط از «کارهای باز» برداشته میشه و تو سابقه می‌مونه.</p>
        <p class="ikiku__links"><a href="/business">برگردم، لازمش دارم</a></p>
      </div></div>
    </t>
  </template>

  <template id="need_cancel" name="لغوِ درخواست">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell ikiku__shell--narrow">
        <p class="ikiku__step">لغوِ درخواست</p>
        <h1 class="ikiku__question">چرا لغو می‌کنید؟</h1>
        <p class="ikiku__lead">بدونِ دلیل لغو نمیشه. کوتاه بنویسید؛ فقط تیمِ ایکیکو می‌بینه.</p>
        <form method="post" class="ikiku__form" data-ikiku-form="">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
          <label for="reason" class="ikiku__label">دلیلِ لغو</label>
          <textarea class="ikiku__field" id="reason" name="reason" rows="4" maxlength="1000" required="required"
                    placeholder="مثلاً: چند هفته تعطیلیم" t-att-aria-invalid="error and 'true'"
                    t-att-aria-describedby="error and 'reason-error'" t-out="reason"/>
          <p t-if="error" id="reason-error" class="ikiku__error" role="alert" t-out="error"/>
          <button class="ikiku__go ikiku__go--block" type="submit">لغو کن</button>
        </form>
        <p class="ikiku__links"><a t-att-href="'/business/need/%d/close' % demand.id">برگردم</a></p>
      </div></div>
    </t>
  </template>

  <!-- A person with several businesses says which one a new need is for. -->
  <template id="need_for" name="برای کدوم کافه یا رستوران">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell ikiku__shell--narrow">
        <p class="ikiku__step">همکارِ تازه</p>
        <h1 class="ikiku__question">برای کدوم کافه یا رستوران؟</h1>
        <div class="ikiku__tiles ikiku__tiles--one">
          <t t-foreach="businesses" t-as="biz">
            <a class="ikiku__tile ikiku__tile--link" t-att-href="'/business/need/for?business=%d' % biz.id"><span t-out="biz.name"/></a>
          </t>
        </div>
        <p class="ikiku__links"><a href="/business/name?new=1">کافه یا رستورانِ دیگه‌ای اضافه کنم</a> <a href="/business">برگردم</a></p>
      </div></div>
    </t>
  </template>

  <!-- Above the tiles: type, choose, and the tile is ticked (ikiku_pick.js, search_suggest).
       Hidden until the script runs; without it the «بنویسید» path below still works. -->
  <template id="role_pick" name="پیدا کردنِ کار با نوشتن">
    <div class="ikiku__pick" data-ikiku-pick="" hidden="hidden">
      <label for="ikiku-pick-q" class="ikiku__label">زودتر پیدا کنید: اسمِ کار رو بنویسید</label>
      <div data-suggest="" data-suggest-url="/standard/suggest?kind=role" data-suggest-count="{n} پیشنهاد">
        <input id="ikiku-pick-q" class="ikiku__field ikiku__field--big" type="search" autocomplete="off"
               maxlength="80" placeholder="مثلاً: کباب‌پز، باریستا، میزبان"/>
      </div>
      <p class="ikiku__lead ikiku__pick-note" data-ikiku-pick-note="" role="status"/>
    </div>
  </template>

</odoo>
