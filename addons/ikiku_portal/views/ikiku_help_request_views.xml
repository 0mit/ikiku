<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ikiku_help_request_list" model="ir.ui.view">
    <field name="name">ikiku.help.request.list</field>
    <field name="model">ikiku.help.request</field>
    <field name="arch" type="xml">
      <list decoration-bf="state == 'new'">
        <field name="create_date" string="زمان"/>
        <field name="name"/>
        <field name="mobile"/>
        <field name="best_time"/>
        <field name="from_page"/>
        <field name="state"/>
      </list>
    </field>
  </record>
  <record id="ikiku_help_request_form" model="ir.ui.view">
    <field name="name">ikiku.help.request.form</field>
    <field name="model">ikiku.help.request</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_called" type="object" string="زنگ زدیم" invisible="state != 'new'" class="btn-primary"/>
          <button name="action_close" type="object" string="بستن" invisible="state == 'closed'"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <p class="text-muted">از شماره‌ی رسمیِ ایکیکو زنگ بزنید. هیچ‌وقت کدِ پیامک را از کسی نخواهید.</p>
          <group>
            <field name="name"/><field name="mobile"/><field name="best_time"/>
            <field name="from_page"/><field name="partner_id"/>
          </group>
          <field name="topic"/>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="action_ikiku_help_request" model="ir.actions.act_window">
    <field name="name">درخواست‌های تماس</field>
    <field name="res_model">ikiku.help.request</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_state': 'new'}</field>
  </record>
  <menuitem id="menu_ikiku_help_request" parent="menu_ikiku_people_help" sequence="5"
            action="action_ikiku_help_request" groups="ikiku_base.group_ikiku_staff"/>
</odoo>
