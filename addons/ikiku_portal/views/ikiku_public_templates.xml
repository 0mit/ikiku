<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="public_profile" name="ایکیکو — پروندهٔ عمومی">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell ikiku__shell--wide">
        <h1 class="ikiku__question" t-out="values.get('name')"/>
        <p class="ikiku__help" t-out="values.get('headline')"/>
        <div class="ikiku__card">
          <div>استان: <strong t-out="values.get('province_id')"/></div>
          <div>اعتبار: <strong t-out="values.get('standing')"/> از ۵</div>
          <div>هویت:
            <strong t-if="values.get('is_verified')">تأییدشده</strong>
            <strong t-else="">هنوز تأیید نشده</strong>
          </div>
        </div>
        <div class="ikiku__note">
          اینجا کارِ این آدم رو می‌بینید. آدرس، شماره و ساعتِ کارش نوشته نمیشه و نمی‌شه.
          <a href="/help/dide">چرا؟</a>
        </div>

        <h3>چیزهایی که گفته شده، و تأییدها</h3>
        <div class="ikiku__table">
          <table>
            <thead><tr>
              <th>چی گفته شده</th><th>کی گفته</th><th>از کجا می‌دونه</th>
              <th>تأیید</th><th>قبول ندارم</th><th>وضعیت</th>
            </tr></thead>
            <tbody>
              <t t-foreach="assertions" t-as="a">
                <tr>
                  <td t-out="a.spec_node_id.name or a.value_text"/>
                  <td t-out="a.asserted_by_id.name"/>
                  <td t-out="dict(a._fields['method'].selection).get(a.method)"/>
                  <td t-out="a.confirm_count"/>
                  <td t-out="a.dispute_count"/>
                  <td t-out="dict(a._fields['state'].selection).get(a.state)"/>
                </tr>
              </t>
            </tbody>
          </table>
        </div>
        <p class="ikiku__lead">
          هیچ عددی بدونِ اینکه معلوم باشه از کجا اومده نشون داده نمیشه. هر حرفی صاحب داره،
          و هر کسی می‌تونه بگه قبول ندارم. <a href="/help/etebar">اعتبار از کجا میاد؟</a>
        </p>

        <h3>قرارهای کار</h3>
        <t t-foreach="bookings" t-as="b">
          <div class="ikiku__card">
            <strong t-out="b['ref']"/> —
            <span t-out="b['date_start_fa']"/> تا <span t-out="b['date_end_fa']"/> ·
            <span t-out="b['province']"/>
            <t t-if="b['business']">
              <div>محلِ کار: <strong t-out="b['business']"/></div>
            </t>
            <t t-else="">
              <div class="ikiku__withheld">اسمِ جای کار تا روزِ شروع نوشته نمیشه.</div>
            </t>
            <t t-if="b['cancelled']">
              <div class="ikiku__withheld">به هم خورد — <span t-out="b['cancel_reason']"/></div>
            </t>
          </div>
        </t>
      </div></div>
    </t>
  </template>

  <template id="public_jobs" name="ایکیکو — کارهای باز">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell ikiku__shell--wide">
        <p class="ikiku__kicker">همه می‌بینن</p>
        <h1 class="ikiku__question">کارهای باز</h1>
        <p class="ikiku__lead">
          نیرویی که کافه‌ها و رستوران‌ها لازم دارن. اسمِ کافه یا رستوران اینجا نوشته نمیشه.
          کار می‌خواید؟ <a href="/ki">ثبت‌نام کنید</a>.
        </p>
        <form class="ikiku__filter" action="/jobs" method="get">
          <label for="province">استان</label>
          <select class="ikiku__field" id="province" name="province">
            <option value="">همهٔ استان‌ها</option>
            <t t-foreach="provinces" t-as="p">
              <option t-att-value="p.id" t-att-selected="'selected' if p.id == province_id else None"
                      t-out="p.name"/>
            </t>
          </select>
          <button class="ikiku__go" type="submit">نمایش</button>
        </form>
        <t t-call="ikiku_portal.job_cards"/>
        <p class="ikiku__lead">
          اسمِ هر کار همون اسمِ رایجه، نه اسمی که هر مغازه خودش گذاشته؛ تا کسی که جای دیگه
          کار کرده بفهمه این چه کاریه.
        </p>
      </div></div>
    </t>
  </template>

  <template id="public_bookings" name="ایکیکو — دفترِ عمومیِ تعهدها">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell ikiku__shell--wide">
        <h1 class="ikiku__question">دفترِ قرارهای کار</h1>
        <div class="ikiku__note">
          هر قرارِ کاری همون لحظه اینجا نوشته میشه، و هر قراری که به هم بخوره هم. اسمِ جای کار
          تا روزِ شروع نوشته نمیشه. قولی که جلوی همه داده شده، بی‌سروصدا پس گرفته نمیشه.
          <a href="/help/daftar">این دفتر رو چطوری بخونم؟</a>
        </div>
        <div class="ikiku__table">
          <table>
            <thead><tr>
              <th>شماره‌ی قرار</th><th>کارگر</th><th>از</th><th>تا</th><th>استان</th>
              <th>جای کار</th><th>وضعیت</th>
            </tr></thead>
            <tbody>
              <t t-foreach="bookings" t-as="b">
                <tr>
                  <td t-out="b['ref']"/>
                  <td><a t-att-href="'/p/%s' % b['resource_slug']" t-out="b['resource']"/></td>
                  <td t-out="b['date_start_fa']"/>
                  <td t-out="b['date_end_fa']"/>
                  <td t-out="b['province']"/>
                  <td>
                    <t t-if="b['business']"><span t-out="b['business']"/></t>
                    <t t-else=""><span class="ikiku__withheld">تا روزِ شروع</span></t>
                  </td>
                  <td>
                    <t t-if="b['cancelled']">
                      <span class="ikiku__withheld">به هم خورد — <t t-out="b['cancel_reason']"/></span>
                    </t>
                    <t t-else=""><span t-out="{'confirmed': 'قطعی', 'at_risk': 'در خطر', 'replaced': 'نفر عوض شد', 'in_progress': 'سرِ کار', 'done': 'تموم شد'}.get(b['state'], b['state'])"/></t>
                  </td>
                </tr>
              </t>
            </tbody>
          </table>
        </div>
      </div></div>
    </t>
  </template>

  <template id="public_costs" name="ایکیکو — هزینهٔ مشترک">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell ikiku__shell--wide">
        <h1 class="ikiku__question">هزینه‌ی مشترک</h1>
        <div class="ikiku__note">
          ایکیکو از مزدِ کارگر چیزی برنمی‌داره. خرجِ واقعیِ اداره‌کردنِ ایکیکو تو هر دوره بینِ
          کافه‌ها و رستوران‌هایی که ازش استفاده کردن تقسیم میشه، به اندازه‌ی «روز-نفر»: یه نفر،
          یه روز کار. ایکیکو بزرگ‌تر بشه، سهمِ هر روز-نفر کمتر میشه، و عددش همین‌جا نوشته میشه.
          <a href="/help/hazine">مثال ببینید</a>
        </div>
        <div class="ikiku__table">
          <table>
            <thead><tr>
              <th>دوره</th><th>از</th><th>تا</th><th>روز-نفر</th>
              <th>کسب‌وکار</th><th>نرخِ هر روز-نفر</th><th>تغییر نسبت به دورهٔ پیش</th>
            </tr></thead>
            <tbody>
              <t t-foreach="periods" t-as="p">
                <tr>
                  <td t-out="p.name"/>
                  <td t-out="p.date_start_fa"/>
                  <td t-out="p.date_end_fa"/>
                  <td t-out="p.total_person_days"/>
                  <td t-out="p.business_count"/>
                  <td t-out="p.rate_per_person_day"/>
                  <td t-out="'%.1f%%' % p.rate_change_pct"/>
                </tr>
              </t>
            </tbody>
          </table>
        </div>
      </div></div>
    </t>
  </template>

</odoo>
