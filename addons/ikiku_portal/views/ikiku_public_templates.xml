<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="public_profile" name="ایکیکو — پروندهٔ عمومی">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell">
        <h1 class="ikiku__question" t-out="values.get('name')"/>
        <p class="ikiku__help" t-out="values.get('headline')"/>
        <div class="ikiku__card">
          <div>استان: <strong t-out="values.get('province_id')"/></div>
          <div>اعتبار: <strong t-out="values.get('standing')"/> از ۵</div>
          <div>هویت:
            <strong t-if="values.get('is_verified')">تأییدشده</strong>
            <strong t-else="">هنوز تأیید نشده</strong>
          </div>
        </div>
        <div class="ikiku__note">
          آنچه اینجا می‌بینید حرفهٔ این شخص است. نشانی، شمارهٔ تماس و ساعتِ کارِ
          آیندهٔ او عمومی نیست و نخواهد شد — بندِ ۷ مرام‌نامه.
        </div>

        <h3>ادعاها و راست‌آزمایی‌ها</h3>
        <table>
          <thead><tr>
            <th>ادعا</th><th>گویندهٔ ادعا</th><th>از چه راه</th>
            <th>تأیید</th><th>اعتراض</th><th>وضعیت</th>
          </tr></thead>
          <tbody>
            <t t-foreach="assertions" t-as="a">
              <tr>
                <td t-out="a.spec_node_id.name or a.value_text"/>
                <td t-out="a.asserted_by_id.name"/>
                <td t-out="dict(a._fields['method'].selection).get(a.method)"/>
                <td t-out="a.confirm_count"/>
                <td t-out="a.dispute_count"/>
                <td t-out="dict(a._fields['state'].selection).get(a.state)"/>
              </tr>
            </t>
          </tbody>
        </table>
        <p class="ikiku__muted">
          هیچ ستاره‌ای بدونِ زنجیره‌اش نشان داده نمی‌شود. هر ادعا صاحبی دارد و
          هر رأیی قابلِ اعتراض است.
        </p>

        <h3>تعهدهای عمومی</h3>
        <t t-foreach="bookings" t-as="b">
          <div class="ikiku__card">
            <strong t-out="b['ref']"/> —
            <span t-out="b['date_start_fa']"/> تا <span t-out="b['date_end_fa']"/> ·
            <span t-out="b['province']"/>
            <t t-if="b['business']">
              <div>محلِ کار: <strong t-out="b['business']"/></div>
            </t>
            <t t-else="">
              <div class="ikiku__withheld">محلِ کار تا آغازِ کار عمومی نمی‌شود.</div>
            </t>
            <t t-if="b['cancelled']">
              <div class="ikiku__withheld">لغو شد — <span t-out="b['cancel_reason']"/></div>
            </t>
          </div>
        </t>
      </div></div>
    </t>
  </template>

  <template id="public_jobs" name="ایکیکو — کارهای باز">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell">
        <h1 class="ikiku__question">کارهای باز</h1>
        <table>
          <thead><tr><th>جایگاه</th><th>استان</th><th>از</th><th>تا</th><th>نفر</th></tr></thead>
          <tbody>
            <t t-foreach="demands" t-as="d">
              <tr>
                <td t-out="d.position_id.spec_node_id.name"/>
                <td t-out="d.province_id.name"/>
                <td t-out="d.date_start_fa"/>
                <td t-out="d.date_end_fa"/>
                <td t-out="d.seats"/>
              </tr>
            </t>
          </tbody>
        </table>
        <p class="ikiku__muted">
          نامِ جایگاه بر پایهٔ استانداردِ مشترک نوشته شده، نه عنوانِ داخلیِ هر مغازه —
          تا کسی که جای دیگری آموزش دیده بفهمد این کار چیست.
        </p>
      </div></div>
    </t>
  </template>

  <template id="public_bookings" name="ایکیکو — دفترِ عمومیِ تعهدها">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell">
        <h1 class="ikiku__question">دفترِ عمومیِ تعهدها</h1>
        <div class="ikiku__note">
          هر گمارش همان لحظه اینجا ثبت می‌شود، و هر لغو هم. محلِ کار تا آغازِ کار
          نوشته نمی‌شود. تعهدی که عمومی اعلام شده، بی‌سروصدا پس گرفته نمی‌شود.
        </div>
        <table>
          <thead><tr>
            <th>شناسه</th><th>نیرو</th><th>از</th><th>تا</th><th>استان</th>
            <th>محلِ کار</th><th>وضعیت</th>
          </tr></thead>
          <tbody>
            <t t-foreach="bookings" t-as="b">
              <tr>
                <td t-out="b['ref']"/>
                <td><a t-att-href="'/ikiku/p/%s' % b['resource_slug']" t-out="b['resource']"/></td>
                <td t-out="b['date_start_fa']"/>
                <td t-out="b['date_end_fa']"/>
                <td t-out="b['province']"/>
                <td>
                  <t t-if="b['business']"><span t-out="b['business']"/></t>
                  <t t-else=""><span class="ikiku__withheld">تا آغازِ کار</span></t>
                </td>
                <td>
                  <t t-if="b['cancelled']">
                    <span class="ikiku__withheld">لغو — <t t-out="b['cancel_reason']"/></span>
                  </t>
                  <t t-else=""><span t-out="b['state']"/></t>
                </td>
              </tr>
            </t>
          </tbody>
        </table>
      </div></div>
    </t>
  </template>

  <template id="public_costs" name="ایکیکو — هزینهٔ مشترک">
    <t t-call="website.layout">
      <div class="ikiku"><div class="ikiku__shell">
        <h1 class="ikiku__question">هزینهٔ مشترک</h1>
        <div class="ikiku__note">
          ایکیکو از فاصلهٔ میان کارگر و کارفرما نان نمی‌خورد. هزینهٔ واقعیِ اداره‌کردنِ
          پلتفرم در هر دوره میانِ کسب‌وکارهایی که استفاده کرده‌اند، به نسبتِ روز-نفر
          تقسیم می‌شود. هرچه سامانه بزرگ‌تر شود، سهمِ هر روز-نفر کمتر — و آن عدد
          همین‌جا نوشته می‌شود تا بشود بررسی‌اش کرد.
        </div>
        <table>
          <thead><tr>
            <th>دوره</th><th>از</th><th>تا</th><th>روز-نفر</th>
            <th>کسب‌وکار</th><th>نرخِ هر روز-نفر</th><th>تغییر نسبت به دورهٔ پیش</th>
          </tr></thead>
          <tbody>
            <t t-foreach="periods" t-as="p">
              <tr>
                <td t-out="p.name"/>
                <td t-out="p.date_start_fa"/>
                <td t-out="p.date_end_fa"/>
                <td t-out="p.total_person_days"/>
                <td t-out="p.business_count"/>
                <td t-out="p.rate_per_person_day"/>
                <td t-out="'%.1f%%' % p.rate_change_pct"/>
              </tr>
            </t>
          </tbody>
        </table>
      </div></div>
    </t>
  </template>

</odoo>
