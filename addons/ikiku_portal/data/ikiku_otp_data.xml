<?xml version="1.0" encoding="utf-8"?>
<odoo><data noupdate="1">
  <!-- Triggered the moment a code is asked for; the interval only sweeps up what a
       trigger missed and deletes challenges older than a day. -->
  <record id="ir_cron_ikiku_mobile_challenge_send" model="ir.cron" forcecreate="True">
    <field name="name">ایکیکو: فرستادنِ کدِ تأییدِ موبایل</field>
    <field name="model_id" ref="model_ikiku_mobile_challenge"/>
    <field name="state">code</field>
    <field name="code">model._cron_send()</field>
    <field name="user_id" ref="base.user_root"/>
    <field name="interval_number">5</field>
    <field name="interval_type">minutes</field>
  </record>
</data></odoo>
