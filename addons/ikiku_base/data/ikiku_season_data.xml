<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Jalali-fixed seasons: the arithmetic is authoritative. -->
    <record id="season_nowruz" model="ikiku.season">
      <field name="name">نوروز</field>
      <field name="sequence">1</field>
      <field name="calendar">jalali</field>
      <field name="start_month">1</field>
      <field name="start_day">1</field>
      <field name="duration_days">13</field>
      <field name="demand_factor">1.6</field>
      <field name="note">اوجِ سفر و بیرون‌غذاخوردن در سراسر کشور.</field>
    </record>

    <record id="season_summer" model="ikiku.season">
      <field name="name">تابستان</field>
      <field name="sequence">2</field>
      <field name="calendar">jalali</field>
      <field name="start_month">4</field>
      <field name="start_day">1</field>
      <field name="duration_days">93</field>
      <field name="demand_factor">1.3</field>
    </record>

    <record id="season_yalda" model="ikiku.season">
      <field name="name">شب یلدا</field>
      <field name="sequence">3</field>
      <field name="calendar">jalali</field>
      <field name="start_month">9</field>
      <field name="start_day">30</field>
      <field name="duration_days">1</field>
      <field name="demand_factor">1.5</field>
    </record>

    <!-- Hijri seasons drift ~11 days a year and Iran determines them by
         observation. These materialise UNCONFIRMED and wait for a human. -->
    <record id="season_ramadan" model="ikiku.season">
      <field name="name">رمضان</field>
      <field name="sequence">4</field>
      <field name="calendar">hijri</field>
      <field name="start_month">9</field>
      <field name="start_day">1</field>
      <field name="duration_days">30</field>
      <field name="demand_factor">0.55</field>
      <field name="note">ساعتِ کارِ کافه‌ها جابه‌جا می‌شود و تقاضای روز به‌شدت می‌افتد. بازه رؤیتی است.</field>
    </record>

    <record id="season_muharram" model="ikiku.season">
      <field name="name">محرم</field>
      <field name="sequence">5</field>
      <field name="calendar">hijri</field>
      <field name="start_month">1</field>
      <field name="start_day">1</field>
      <field name="duration_days">12</field>
      <field name="demand_factor">0.7</field>
    </record>
  </data>
</odoo>
