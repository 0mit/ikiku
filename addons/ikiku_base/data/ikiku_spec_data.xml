<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- The protocols and attributes. Families, roles and skills are in ikiku.spec.node.csv,
       which loads first so these can hang under spec_fnb. -->
  <data noupdate="1">
    <record id="spec_hygiene" model="ikiku.spec.node">
      <field name="name">بهداشت و ایمنی</field>
      <field name="code">hygiene</field>
      <field name="kind">protocol</field>
      <field name="parent_id" ref="spec_fnb"/>
      <field name="hint_terms">بهداشت ایمنی</field>
    </record>
    <record id="spec_handwash" model="ikiku.spec.node">
      <field name="name">شست‌وشوی دست</field>
      <field name="code">handwash</field>
      <field name="kind">step</field>
      <field name="parent_id" ref="spec_hygiene"/>
      <field name="hint_terms">شستن دست</field>
    </record>
    <record id="spec_coldchain" model="ikiku.spec.node">
      <field name="name">زنجیرهٔ سرما</field>
      <field name="code">cold-chain</field>
      <field name="kind">step</field>
      <field name="parent_id" ref="spec_hygiene"/>
      <field name="hint_terms">یخچال دما فریزر</field>
    </record>
    <record id="spec_crosscontam" model="ikiku.spec.node">
      <field name="name">آلودگیِ متقاطع</field>
      <field name="code">cross-contamination</field>
      <field name="kind">step</field>
      <field name="parent_id" ref="spec_hygiene"/>
      <field name="hint_terms">تخته جدا آلودگی</field>
    </record>
    <record id="spec_shift" model="ikiku.spec.node">
      <field name="name">شیفت</field>
      <field name="code">shift</field>
      <field name="kind">attribute</field>
      <field name="parent_id" ref="spec_fnb"/>
      <field name="hint_terms">شیفت نوبت</field>
    </record>
    <record id="spec_shift_morning" model="ikiku.spec.node">
      <field name="name">شیفت صبح</field>
      <field name="code">shift-morning</field>
      <field name="kind">attribute</field>
      <field name="parent_id" ref="spec_shift"/>
      <field name="hint_terms">صبح صبحانه</field>
    </record>
    <record id="spec_shift_evening" model="ikiku.spec.node">
      <field name="name">شیفت عصر</field>
      <field name="code">shift-evening</field>
      <field name="kind">attribute</field>
      <field name="parent_id" ref="spec_shift"/>
      <field name="hint_terms">عصر بعدازظهر</field>
    </record>
    <record id="spec_shift_night" model="ikiku.spec.node">
      <field name="name">شیفت شب</field>
      <field name="code">shift-night</field>
      <field name="kind">attribute</field>
      <field name="parent_id" ref="spec_shift"/>
      <field name="hint_terms">شب شبانه وایسه شب‌کار</field>
    </record>
    <!-- Inside noupdate, so it runs on install only: a label a master changes survives -u. -->
  </data>
</odoo>
