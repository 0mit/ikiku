      <field name="model_name">ikiku.demand</field>
      <field name="field_name">city</field>
      <field name="visibility">public</field>
      <field name="reason">شهرِ کار، نه نشانیِ آن. تصمیمِ اپراتور، ۲۵ شهریور ۱۴۰۵.</field>
    </record>
    <record id="vis_ikiku_demand_date_start" model="ikiku.visibility.policy">
      <field name="model_name">ikiku.demand</field>
