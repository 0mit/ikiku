<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="vis_res_partner_name" model="ikiku.visibility.policy">
      <field name="model_name">res.partner</field>
      <field name="field_name">name</field>
      <field name="visibility">public</field>
      <field name="reason">نامِ حرفه‌ای بخشی از پروندهٔ عمومی است.</field>
    </record>
    <record id="vis_res_partner_ikiku_province_id" model="ikiku.visibility.policy">
      <field name="model_name">res.partner</field>
      <field name="field_name">ikiku_province_id</field>
      <field name="visibility">public</field>
      <field name="reason">استان، نه نشانی. برای یافتنِ کار لازم است.</field>
    </record>
    <record id="vis_res_partner_ikiku_city" model="ikiku.visibility.policy">
      <field name="model_name">res.partner</field>
      <field name="field_name">ikiku_city</field>
      <field name="visibility">public</field>
