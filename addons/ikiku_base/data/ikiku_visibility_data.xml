      <field name="reason">اینکه هویت تأیید شده یا نه، خودش یک واقعیتِ عمومی است.</field>
    </record>
    <record id="vis_res_partner_function" model="ikiku.visibility.policy">
      <field name="model_name">res.partner</field>
