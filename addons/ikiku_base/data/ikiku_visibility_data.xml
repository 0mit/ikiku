      <field name="model_name">res.partner</field>
      <field name="field_name">ikiku_nid_checked_on</field>
      <field name="visibility">restricted</field>
      <field name="reason">تاریخِ بررسی هم داده‌ای دربارهٔ فرد است.</field>
