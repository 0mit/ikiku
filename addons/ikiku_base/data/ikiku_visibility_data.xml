      <field name="model_name">ikiku.demand</field>
      <field name="field_name">position_id</field>
      <field name="visibility">restricted</field>
      <field name="reason">عنوانِ داخلیِ هر مغازه است؛ عموم نامِ استانداردِ همان کار را می‌بیند.</field>
    </record>
    <record id="vis_ikiku_demand_business_id" model="ikiku.visibility.policy">
      <field name="model_name">ikiku.demand</field>
      <field name="field_name">business_id</field>
      <field name="visibility">restricted</field>
      <field name="reason">بند ۷: محلِ کار تا آغازِ کار عمومی نیست.</field>
    </record>
    <record id="vis_ikiku_demand_note" model="ikiku.visibility.policy">
      <field name="model_name">ikiku.demand</field>
      <field name="field_name">note</field>
