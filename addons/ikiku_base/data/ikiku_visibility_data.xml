      <field name="visibility">public</field>
      <field name="reason">از کِی؛ دربارهٔ کار است، نه برنامهٔ کسی.</field>
    </record>
    <record id="vis_ikiku_demand_date_end" model="ikiku.visibility.policy">
      <field name="model_name">ikiku.demand</field>
      <field name="field_name">date_end</field>
      <field name="visibility">public</field>
      <field name="reason">تا کِی، یا بدون پایان؛ دربارهٔ کار است.</field>
    </record>
    <record id="vis_ikiku_demand_work_type_id" model="ikiku.visibility.policy">
      <field name="model_name">ikiku.demand</field>
      <field name="field_name">work_type_id</field>
      <field name="visibility">public</field>
      <field name="reason">نوعِ همکاری؛ دربارهٔ کار است.</field>
    </record>
