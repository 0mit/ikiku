<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Inside noupdate, so each runs ONCE: an order changed afterwards survives -u. The
         second was added on 2026-09-18, when a street called «اندیشه» in another town was
         coming before the town of that name; it sets the order of every kind and of the
         cities people name most, and re-applies the provinces on top. -->
    <function model="place.node" name="_ikiku_apply_province_order"/>
    <function model="place.node" name="_ikiku_apply_place_order"/>
  </data>
</odoo>
