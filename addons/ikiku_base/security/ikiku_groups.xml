<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_ikiku" model="ir.module.category">
    <field name="name">ایکیکو</field>
    <field name="description">تعاونی سنجش و تأمین نیروی حرفه‌ای</field>
    <field name="sequence">20</field>
  </record>

  <!-- Odoo 18+ hangs groups off a privilege, and the privilege off the category;
       res.groups no longer has category_id. -->
  <record id="privilege_ikiku" model="res.groups.privilege">
    <field name="name">ایکیکو</field>
    <field name="sequence">10</field>
    <field name="category_id" ref="module_category_ikiku"/>
  </record>

  <record id="group_ikiku_resource" model="res.groups">
    <field name="name">نیرو</field>
    <field name="privilege_id" ref="privilege_ikiku"/>
    <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
  </record>

  <record id="group_ikiku_business" model="res.groups">
    <field name="name">کسب‌وکار</field>
    <field name="privilege_id" ref="privilege_ikiku"/>
    <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
  </record>

  <record id="group_ikiku_academy" model="res.groups">
    <field name="name">آموزشگاه</field>
    <field name="privilege_id" ref="privilege_ikiku"/>
    <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
  </record>

  <!-- The administrator is iKiKu staff (operator, 2026-09-17): the «کمک به آدم‌ها» menus, the
       login-number badge and every staff-only field are behind this group. Set here on the group,
       which this module owns: base.user_admin is noupdate data of base and ignores other modules. -->
  <record id="group_ikiku_staff" model="res.groups">
    <field name="name">کارکنان پلتفرم</field>
    <field name="privilege_id" ref="privilege_ikiku"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
  </record>

  <record id="group_ikiku_master" model="res.groups">
    <field name="name">مسئول فنی (نگهدارندهٔ استاندارد)</field>
    <field name="privilege_id" ref="privilege_ikiku"/>
    <field name="implied_ids" eval="[(4, ref('group_ikiku_staff'))]"/>
  </record>
</odoo>
