<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_assertion_list" model="ir.ui.view">
    <field name="name">ikiku.assertion.list</field>
    <field name="model">ikiku.assertion</field>
    <field name="arch" type="xml">
      <list string="ادعاها" decoration-danger="state == 'contested'"
            decoration-success="state == 'supported'">
        <field name="resource_id"/>
        <field name="claim_kind"/>
        <field name="spec_node_id"/>
        <field name="asserted_by_id"/>
        <field name="method"/>
        <field name="confirm_count"/>
        <field name="dispute_count"/>
        <field name="strength"/>
        <field name="state"/>
      </list>
    </field>
  </record>

  <record id="view_assertion_form" model="ir.ui.view">
    <field name="name">ikiku.assertion.form</field>
    <field name="model">ikiku.assertion</field>
    <field name="arch" type="xml">
      <form string="ادعا">
        <sheet>
          <group>
            <group>
              <field name="resource_id"/>
              <field name="claim_kind"/>
              <field name="spec_node_id"/>
              <field name="value_text"/>
            </group>
            <group>
              <field name="asserted_by_id"/>
              <field name="method"/>
              <field name="asserted_on"/>
              <field name="state"/>
              <field name="strength" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="راست‌آزمایی‌ها">
              <field name="verification_ids">
                <list editable="bottom">
                  <field name="verifier_id"/>
                  <field name="verdict"/>
                  <field name="evidence"/>
                  <field name="verified_on"/>
                  <field name="verifier_standing" readonly="1"/>
                  <field name="weight" readonly="1"/>
                  <field name="is_public"/>
                </list>
              </field>
            </page>
            <page string="پرونده">
              <field name="dispute_id" readonly="1"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_assertion" model="ir.actions.act_window">
    <field name="name">دفترِ ادعاها</field>
    <field name="res_model">ikiku.assertion</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="view_dispute_form" model="ir.ui.view">
    <field name="name">ikiku.dispute.form</field>
    <field name="model">ikiku.dispute</field>
    <field name="arch" type="xml">
      <form string="پرونده">
        <sheet>
          <div class="alert alert-warning" role="alert">
            بند ۴ — تا وقتی هر دو طرف گفته‌شان را ثبت نکرده‌اند، رأی صادر نمی‌شود.
          </div>
          <group>
            <group>
              <field name="opener_id"/>
              <field name="respondent_id"/>
              <field name="assertion_id"/>
            </group>
            <group>
              <field name="state"/>
              <field name="ruled_on" readonly="1"/>
              <field name="is_public"/>
            </group>
          </group>
          <field name="ground" placeholder="موضوعِ اختلاف"/>
          <group>
            <field name="opener_statement" placeholder="گفتهٔ شاکی"/>
            <field name="respondent_statement" placeholder="گفتهٔ طرفِ مقابل"/>
          </group>
          <field name="ruling" placeholder="رأی" readonly="state != 'heard'"/>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_dispute" model="ir.actions.act_window">
    <field name="name">پرونده‌ها</field>
    <field name="res_model">ikiku.dispute</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
