<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_spec_node_list" model="ir.ui.view">
    <field name="name">ikiku.spec.node.list</field>
    <field name="model">ikiku.spec.node</field>
    <field name="arch" type="xml">
      <list string="درخت استاندارد">
        <field name="complete_code"/>
        <field name="name"/>
        <field name="kind"/>
        <field name="version"/>
        <field name="active" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="view_spec_node_form" model="ir.ui.view">
    <field name="name">ikiku.spec.node.form</field>
    <field name="model">ikiku.spec.node</field>
    <field name="arch" type="xml">
      <form string="گرهٔ استاندارد">
        <sheet>
          <div class="oe_title">
            <h1><field name="name" placeholder="نام گره"/></h1>
            <h3><field name="complete_code" readonly="1"/></h3>
          </div>
          <group>
            <group>
              <field name="code"/>
              <field name="kind"/>
              <field name="parent_id"/>
            </group>
            <group>
              <field name="version"/>
              <field name="name_en"/>
              <field name="promoted_from_id" readonly="1"
                     invisible="not promoted_from_id"/>
              <field name="active"/>
            </group>
          </group>
          <notebook>
            <page string="شرح">
              <field name="description" placeholder="این گره چه می‌گوید؟"/>
            </page>
            <page string="واژه‌های راهنما">
              <field name="hint_terms"
                     placeholder="واژه‌هایی که کاربر ممکن است به‌جای این گره بنویسد"/>
            </page>
            <page string="لایه‌های محلی">
              <field name="overlay_ids" readonly="1">
                <list><field name="business_id"/><field name="name"/></list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_spec_node" model="ir.actions.act_window">
    <field name="name">درخت استاندارد</field>
    <field name="res_model">ikiku.spec.node</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="view_spec_candidate_list" model="ir.ui.view">
    <field name="name">ikiku.spec.candidate.list</field>
    <field name="model">ikiku.spec.candidate</field>
    <field name="arch" type="xml">
      <list string="نامزدها" decoration-warning="state == 'queued'">
        <field name="name"/>
        <field name="business_id"/>
        <field name="occurrence"/>
        <field name="state"/>
        <field name="promoted_node_id"/>
      </list>
    </field>
  </record>

  <record id="view_spec_candidate_form" model="ir.ui.view">
    <field name="name">ikiku.spec.candidate.form</field>
    <field name="model">ikiku.spec.candidate</field>
    <field name="arch" type="xml">
      <form string="نامزد">
        <sheet>
          <div class="alert alert-info" role="alert">
            متنِ خام هرگز اصلاح نمی‌شود. اگر با استاندارد جور نیست، استاندارد باید رشد کند —
            نه اینکه گفتهٔ کاربر تغییر کند.
          </div>
          <group>
            <group>
              <field name="name"/>
              <field name="business_id"/>
              <field name="proposed_by_id"/>
            </group>
            <group>
              <field name="occurrence"/>
              <field name="state"/>
              <field name="promoted_node_id" readonly="1"/>
            </group>
          </group>
          <field name="reject_reason" placeholder="اگر رد می‌کنید، چرا؟"
                 invisible="state != 'rejected'"/>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_spec_candidate" model="ir.actions.act_window">
    <field name="name">صفِ ارتقا</field>
    <field name="res_model">ikiku.spec.candidate</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_queued': 1}</field>
  </record>

  <record id="view_visibility_policy_list" model="ir.ui.view">
    <field name="name">ikiku.visibility.policy.list</field>
    <field name="model">ikiku.visibility.policy</field>
    <field name="arch" type="xml">
      <list string="سیاست نمایش" editable="bottom"
            decoration-danger="visibility == 'restricted'"
            decoration-success="visibility == 'public'">
        <field name="model_name"/>
        <field name="field_name"/>
        <field name="visibility"/>
        <field name="reason"/>
      </list>
    </field>
  </record>

  <record id="action_visibility_policy" model="ir.actions.act_window">
    <field name="name">سیاست نمایش (بند ۷)</field>
    <field name="res_model">ikiku.visibility.policy</field>
    <field name="view_mode">list</field>
  </record>
</odoo>
