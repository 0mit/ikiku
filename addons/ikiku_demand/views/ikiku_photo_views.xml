<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Photos wait here for a person to look at them. Nothing is public before «تأیید»;
       a rejection needs a reason, which the owner reads on their own page. -->
  <record id="view_photo_kanban" model="ir.ui.view">
    <field name="name">ikiku.photo.kanban</field>
    <field name="model">ikiku.photo</field>
    <field name="arch" type="xml">
      <kanban default_group_by="state" records_draggable="0">
        <field name="state"/>
        <templates>
          <t t-name="card">
            <field name="image" widget="image" options="{'size': [0, 180]}"/>
            <div class="mt-1">
              <field name="partner_id"/><field name="business_id"/>
            </div>
            <div class="text-muted small"><field name="create_date"/></div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_photo_form" model="ir.ui.view">
    <field name="name">ikiku.photo.form</field>
    <field name="model">ikiku.photo</field>
    <field name="arch" type="xml">
      <form string="عکس" create="0">
        <header>
          <button name="action_approve" type="object" string="تأیید؛ برای همه دیده شود" class="btn-primary"
                  invisible="state == 'approved'"/>
          <button name="action_reject" type="object" string="رد" invisible="state == 'rejected'"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <field name="image" widget="image" options="{'size': [0, 480]}" readonly="1"/>
          <group>
            <group>
              <field name="partner_id" readonly="1" invisible="not partner_id"/>
              <field name="business_id" readonly="1" invisible="not business_id"/>
              <field name="create_date" string="فرستاده شد" readonly="1"/>
            </group>
            <group>
              <field name="reviewed_by" invisible="not reviewed_by"/>
              <field name="reviewed_on" invisible="not reviewed_on"/>
            </group>
          </group>
          <group string="دلیلِ رد (صاحبِ عکس این را می‌بیند)">
            <field name="reject_reason" nolabel="1" colspan="2"
                   placeholder="برای رد لازم است: مثلاً «صورتِ کسِ دیگری در عکس است» یا «نشانیِ خانه پیداست»."/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_photo_search" model="ir.ui.view">
    <field name="name">ikiku.photo.search</field>
    <field name="model">ikiku.photo</field>
    <field name="arch" type="xml">
      <search>
        <field name="partner_id"/>
        <field name="business_id"/>
        <filter name="waiting" string="در انتظارِ بررسی" domain="[('state', '=', 'pending')]"/>
      </search>
    </field>
  </record>

  <record id="action_photo" model="ir.actions.act_window">
    <field name="name">عکس‌ها</field>
    <field name="res_model">ikiku.photo</field>
    <field name="view_mode">kanban,form</field>
    <field name="context">{'search_default_waiting': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">عکسی منتظرِ بررسی نیست.</p>
      <p>عکس‌هایی که آدم‌ها و کافه‌ها می‌فرستند اینجا می‌مانند تا کسی نگاهشان کند. تا تأیید نشوند، جز صاحبشان کسی نمی‌بیندشان.</p>
    </field>
  </record>

  <menuitem id="menu_ikiku_photo" name="عکس‌ها" parent="ikiku_base.menu_ikiku_root"
            action="action_photo" sequence="8"/>
</odoo>
