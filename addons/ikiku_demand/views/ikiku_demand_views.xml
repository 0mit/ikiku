<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_business_form" model="ir.ui.view">
    <field name="name">ikiku.business.form</field>
    <field name="model">ikiku.business</field>
    <field name="arch" type="xml">
      <form string="کسب‌وکار">
        <header><field name="state" widget="statusbar"/></header>
        <sheet>
          <div class="oe_title"><h1><field name="name" placeholder="نامِ کافه یا رستوران"/></h1></div>
          <group>
            <group>
              <field name="partner_id"/><field name="kind"/><field name="seats"/>
            </group>
            <group>
              <field name="place_id" options="{'no_create': True}"/>
              <field name="place_path" readonly="1"/>
              <field name="place_hint" readonly="1" invisible="not place_hint"/>
              <field name="place_visibility" widget="radio"/>
              <field name="place_public_id" readonly="1"/>
              <field name="province_id"/><field name="city"/>
              <field name="name_public"/>
              <field name="public_name" readonly="1" invisible="not name_public"/>
              <field name="is_verified" readonly="1"/><field name="slug" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="عکس‌ها" name="photos">
              <field name="photo_ids" mode="kanban" readonly="1">
                <kanban>
                  <field name="state"/>
                  <templates><t t-name="card">
                    <field name="image" widget="image" options="{'size': [0, 120]}"/>
                    <field name="state" widget="badge"/>
                  </t></templates>
                </kanban>
              </field>
            </page>
            <page string="جایگاه‌های شغلی">
              <field name="position_ids">
                <list editable="bottom">
                  <field name="name"/>
                  <field name="spec_node_id"/>
                  <field name="required_node_ids" widget="many2many_tags"/>
                  <field name="nice_node_ids" widget="many2many_tags"/>
                  <field name="candidate_id" readonly="1"/>
                </list>
              </field>
            </page>
            <page string="لایه‌های محلی">
              <field name="overlay_ids">
                <list editable="bottom">
                  <field name="name"/><field name="node_id"/><field name="sequence"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="view_business_list" model="ir.ui.view">
    <field name="name">ikiku.business.list</field>
    <field name="model">ikiku.business</field>
    <field name="arch" type="xml">
      <list string="کسب‌وکارها">
        <field name="name"/><field name="kind"/><field name="province_id"/>
        <field name="city"/><field name="is_verified"/><field name="state"/>
      </list>
    </field>
  </record>
  <record id="action_business" model="ir.actions.act_window">
    <field name="name">کسب‌وکارها</field>
    <field name="res_model">ikiku.business</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="view_demand_list" model="ir.ui.view">
    <field name="name">ikiku.demand.list</field>
    <field name="model">ikiku.demand</field>
    <field name="arch" type="xml">
      <list string="نیازها" decoration-success="state == 'filled'"
            decoration-info="state == 'open'">
        <field name="business_id"/><field name="position_id"/><field name="seats"/>
        <field name="date_start_fa" string="از"/><field name="date_end_fa" string="تا"/>
        <field name="province_id"/><field name="season_factor"/><field name="state"/>
      </list>
    </field>
  </record>
  <record id="view_demand_form" model="ir.ui.view">
    <field name="name">ikiku.demand.form</field>
    <field name="model">ikiku.demand</field>
    <field name="arch" type="xml">
      <form string="اعلام نیاز">
        <header>
          <button name="action_open" type="object" string="باز کردن"
                  class="btn-primary" invisible="state != 'draft'"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="business_id"/><field name="position_id"/><field name="seats"/>
              <field name="work_type_id"/>
            </group>
            <group>
              <field name="date_start"/><field name="date_start_fa"/>
              <field name="date_end"/><field name="date_end_fa"/>
              <field name="province_id"/><field name="city"/>
              <field name="season_factor" readonly="1"/>
            </group>
          </group>
          <field name="note"/>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="action_demand" model="ir.actions.act_window">
    <field name="name">نیازها</field>
    <field name="res_model">ikiku.demand</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
