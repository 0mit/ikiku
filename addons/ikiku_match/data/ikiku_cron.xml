<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="cron_raise_due_checks" model="ir.cron">
      <field name="name">ایکیکو: گشودنِ کارِ بازبینی‌های سررسیده</field>
      <field name="model_id" ref="model_ikiku_booking_check"/>
      <field name="state">code</field>
      <field name="code">model._cron_raise_due_checks()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="active" eval="True"/>
    </record>
    <record id="cron_move_bookings" model="ir.cron">
      <field name="name">ایکیکو: آغاز و پایانِ گمارش‌ها</field>
      <field name="model_id" ref="model_ikiku_booking_check"/>
      <field name="state">code</field>
      <field name="code">model._cron_start_and_close_bookings()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="active" eval="True"/>
    </record>
  </data>
</odoo>
